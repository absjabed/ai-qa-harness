# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Every key the harness reads is listed here, marked:
#   REQUIRED     the suite will not run without it
#   REQUIRED IF  needed only when the feature it names is in scope
#   OPTIONAL     has a default, shown as the value below
#
# This file is for the TEST SUITE — what `npm test` runs with. The AI agents never read it (it is denied in
# .claude/settings.json). Their own access — browser, database, tracker — is configured in .mcp.json.

# ---- Project identity — mirrors PROJECT-PROFILE.md sections 1 and 5 ----
# REQUIRED. Unset, both fall back to CHANGE_ME, which then appears in report titles and log output.
APP_NAME=
TRACKER_PROJECT_KEY=
# OPTIONAL. Whether DB-backed assertions and the database readiness check are in scope.
DB_VALIDATION_ENABLED=true
# OPTIONAL. Whether the `api` project's specs run.
API_TESTS_ENABLED=false

# ---- Application under test ----
# REQUIRED. There is deliberately no default: an unset URL stops the run rather than testing the wrong system.
BASE_URL=
# OPTIONAL. Path the baseline role lands on after login, used by smoke assertions.
LANDING_PATH=/

# ---- Credentials — one pair per role in config/projectProfile.ts ----
# REQUIRED, per role you test: the role key uppercased and split on camelCase (caseWorker -> CASE_WORKER_).
# Each role's login seed in tests/seeds/ reads its pair. Add or remove pairs to match your roles.
# Use QA-only test accounts — never a person's own account, never one that works in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STANDARD_USER_EMAIL=
STANDARD_USER_PASSWORD=
READ_ONLY_USER_EMAIL=
READ_ONLY_USER_PASSWORD=
# OPTIONAL. An account that must FAIL to log in, for negative tests. Defaults to an address that cannot exist.
INVALID_EMAIL=
INVALID_PASSWORD=

# ---- Entry criteria and test data — PROJECT-PROFILE.md section 10 ----
# OPTIONAL. Before every run, lib/globalSetup.ts checks BASE_URL (and the database, if in scope) is
# reachable. true skips that — only for an API-only run, or to knowingly run against a failing environment.
SKIP_READINESS_CHECK=false
# OPTIONAL. true runs data/seed.ts (reset, then seed) once before the suite, putting data into a known state.
SEED_TEST_DATA=false
# OPTIONAL. After every run, the cycle report for the stories that ran is written to reports/. false turns
# that off; `npm run report:cycle` still builds one by hand.
AUTO_CYCLE_REPORT=true
# OPTIONAL. The build or version of the application under test, as the team names it — e.g. 2.26.0-rc3.
# Recorded with every automated result and printed in the cycle report, so a closure report says which build
# it covers. Change it when a new build is deployed to the test environment.
BUILD_UNDER_TEST=

# ---- Browser ----
# OPTIONAL.
BROWSER=chromium
# OPTIONAL. true runs headless; anything else runs headed.
HEADLESS=false

# ---- Database — REQUIRED IF DB_VALIDATION_ENABLED=true ----
# The suite's own connection, through the driver in config/db/. It is separate from the agents' database
# access in .mcp.json, and may need more rights than that read-only account — data/seed.ts writes.
# REQUIRED IF: mssql (SQL Server) or postgres (PostgreSQL).
DB_ENGINE=mssql
# REQUIRED IF.
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
# OPTIONAL. Blank means the engine's default: 1433 for SQL Server, 5432 for PostgreSQL.
DB_PORT=
# OPTIONAL. Schema the queries in data/sql_queries.ts use. Blank means dbo on SQL Server, public on PostgreSQL.
DB_SCHEMA_PREFIX=
# OPTIONAL. Turn DB_ENCRYPT off only for a local server without TLS. Turn DB_TRUST_SERVER_CERTIFICATE off
# where the server's certificate is real and should be verified.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# OPTIONAL. Query `npm run db:check` and the readiness check run to prove connectivity. Keep it cheap and read-only.
DB_SMOKE_QUERY=SELECT 1 AS ok

# ---- API — REQUIRED IF API_TESTS_ENABLED=true ----
# REQUIRED IF.
API_BASE_URL=
# OPTIONAL, depending on how your API authenticates.
API_USERNAME=
API_PASSWORD=
