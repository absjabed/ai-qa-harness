# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# ---- Project identity (mirrors PROJECT-PROFILE.md sections 1 and 5) ----
APP_NAME=
TRACKER_PROJECT_KEY=
DB_VALIDATION_ENABLED=true
API_TESTS_ENABLED=false
# Schema the queries in data/sql_queries.ts use. Blank means the engine's default: dbo on SQL Server,
# public on PostgreSQL.
DB_SCHEMA_PREFIX=

# ---- Application under test ----
BASE_URL=
# Optional: a path the baseline role lands on after login, used by smoke assertions.
LANDING_PATH=/

# ---- Entry criteria and test data (see PROJECT-PROFILE.md section 10) ----
# Before every run, lib/globalSetup.ts checks BASE_URL (and the DB, if in scope) is reachable.
# Set true only for an API-only run, or to knowingly run against an environment that fails the check.
SKIP_READINESS_CHECK=false
# true runs data/seed.ts (reset, then seed) before the suite, putting data into a known state.
SEED_TEST_DATA=false

# ---- Browser ----
BROWSER=chromium
# `true` runs headless. Anything else runs headed.
HEADLESS=false

# ---- Database (omit the whole block if DB_VALIDATION_ENABLED=false) ----
# mssql (SQL Server) or postgres (PostgreSQL).
DB_ENGINE=mssql
DB_SERVER=
# Blank means the engine's default: 1433 for SQL Server, 5432 for PostgreSQL.
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# TLS. Turn DB_ENCRYPT off only for a local server without TLS. Turn DB_TRUST_SERVER_CERTIFICATE off
# where the server's certificate is real and should be verified.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Query run by `npm run db:check` to prove connectivity. Keep it cheap and read-only.
DB_SMOKE_QUERY=SELECT 1 AS ok

# ---- Credentials, one pair per role in PROJECT-PROFILE.md section 2 ----
# Role key from projectProfile.ts, uppercased. Add/remove to match your roles.
ADMIN_EMAIL=
ADMIN_PASSWORD=
STANDARD_USER_EMAIL=
STANDARD_USER_PASSWORD=
READ_ONLY_USER_EMAIL=
READ_ONLY_USER_PASSWORD=
# An account that should fail to log in, for negative tests.
INVALID_EMAIL=
INVALID_PASSWORD=

# ---- API (omit if API_TESTS_ENABLED=false) ----
API_BASE_URL=
API_USERNAME=
API_PASSWORD=
