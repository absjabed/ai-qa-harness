      "replace": [
        [
          "import DbConnection from '../config/DbConnection';\n",
          ""
        ],
        [
          "    const db = new DbConnection();\n    try {\n        // CHANGE_ME — e.g.\n        // await db.executeUpdate(sqlQueries.resetTestRecords);\n    } finally {\n        await db.close();\n    }\n}",
          "    // FleetKeep demo: the app has a reset endpoint instead of a database the suite can reach.\n    const response = await fetch(`${process.env.BASE_URL}/__reset`, { method: 'POST' });\n    if (!response.ok) throw new Error(`Resetting FleetKeep demo data failed: HTTP ${response.status}`);\n}"
        ],
        [
          "    const db = new DbConnection();\n    try {\n        // CHANGE_ME — e.g.\n        // await db.executeUpdate(sqlQueries.seedValidRecord(recordData.validIdentifier));\n    } finally {\n        await db.close();\n    }\n}",
          "    // FleetKeep demo: the reset restores the seed data, so there is nothing more to create.\n}"
        ]
      ]
    },
    {
      "file": "PROJECT-PROFILE.md",
      "replace": [
        [
          "| Application name | `<AppName>` |",
