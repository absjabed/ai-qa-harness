" parent="p9c1" source="p9c8" target="p9c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="530" /></Array></mxGeometry></mxCell><mxCell id="p9c22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c9" target="p9c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c9" target="p9c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.136;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c10" target="p9c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.864;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c11" target="p9c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c12" target="p9c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c13" target="p9c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c14" target="p9c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c29" value="/playwright-test-healer: retest raised defects" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="420" y="1220" width="440" height="40" as="geometry" /></mxCell><mxCell id="p9c30" value="&lt;b&gt;Find what to retest&lt;/b&gt;&lt;br&gt;with Jira connected: raised entries Jira shows done&lt;br&gt;or the ones you name" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="420" y="1300" width="440" height="80" as="geometry" /></mxCell><mxCell id="p9c31" value="&lt;b&gt;Automated&lt;br&gt;test?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="510" y="1420" width="260" height="120" as="geometry" /></mxCell><mxCell id="p9c32" value="&lt;b&gt;Tester re-executes&lt;/b&gt;&lt;br&gt;the manual case and reports the outcome" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="900" y="1445" width="340" height="70" as="geometry" /></mxCell><mxCell id="p9c33" value="&lt;b&gt;test.fixme( → test( · run it twice&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="420" y="1580" width="440" height="50" as="geometry" /></mxCell><mxCell id="p9c34" value="&lt;b&gt;Passed?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;both runs, or the&lt;br&gt;tester's re-run&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="510" y="1680" width="260" height="140" as="geometry" /></mxCell><mxCell id="p9c35" value="&lt;b&gt;Restore test.fixme(&lt;/b&gt;&lt;br&gt;entry stays raised&lt;br&gt;lastRetestAt and lastRetestResult recorded" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="900" y="1700" width="340" height="80" as="geometry" /></mxCell><mxCell id="p9c36" value="&lt;b&gt;verified&lt;/b&gt;&lt;br&gt;verifiedAt from npm run env -- now&lt;br&gt;defect comment removed · test active again" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="420" y="1860" width="440" height="80" as="geometry" /></mxCell><mxCell id="p9c37" value="&lt;b&gt;Commit&lt;/b&gt; the spec, the entry and automated-results.csv&lt;br&gt;on the branch the spec lives on (the release branch once merged)&lt;br&gt;defect(&amp;lt;KEY&amp;gt;): &amp;lt;TCID&amp;gt; fixed, verified [defect-verified]" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="420" y="1980" width="440" height="80" as="geometry" /></mxCell><mxCell id="p9c38" value="&lt;b&gt;STOP: comment and status change?&lt;/b&gt;&lt;br&gt;only with Jira connected, asked first&lt;br&gt;transitions from the bug's own workflow; you pick one, or none" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="380" y="2100" width="520" height="90" as="geometry" /></mxCell><mxCell id="p9c39" value="Retest recorded" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="480" y="2230" width="320" height="40" as="geometry" /></mxCell><mxCell id="p9c40" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c29" target="p9c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c41" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c30" target="p9c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c42" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c31" target="p9c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c43" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c31" target="p9c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c33" target="p9c34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c45" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c32" target="p9c34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="1655" /><mxPoint x="640" y="1655" /></Array></mxGeometry></mxCell><mxCell id="p9c46" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c34" target="p9c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c47" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c34" target="p9c36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c48" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c36" target="p9c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c49" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c37" target="p9c38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c50" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p9c1" source="p9c35" target="p9c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="2145" /></Array></mxGeometry></mxCell><mxCell id="p9c51" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p9c1" source="p9c38" target="p9c39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c52" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;a Jira bug, or specs/defects/defects.csv&lt;br&gt;test.fixme( markers in specs&lt;br&gt;the entry's status · raisedAt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="1320" y="130" width="320" height="90" as="geometry" /></mxCell><mxCell id="p9c53" value="&lt;b&gt;Severity mapping&lt;/b&gt;&lt;br&gt;PROJECT-PROFILE.md §7; default&lt;br&gt;P1 → Highest/Critical · P2 → High/Major&lt;br&gt;P3 → Medium/Minor · P4 → Low/Low" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="1320" y="240" width="320" height="90" as="geometry" /></mxCell><mxCell id="p9c54" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;edits, moves or comments on an existing issue&lt;br&gt;writes a CSV row for a bug it created in Jira&lt;br&gt;files a defect with no TCID" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="1320" y="350" width="320" height="90" as="geometry" /></mxCell><mxCell id="p9c55" value="&lt;b&gt;After a CSV import&lt;/b&gt;&lt;br&gt;a person fills each entry's trackerKey; the retest reports against it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="1320" y="1300" width="320" height="80" as="geometry" /></mxCell><mxCell id="p9c56" value="&lt;b&gt;Retest never&lt;/b&gt;&lt;br&gt;marks an entry verified on a single pass&lt;br&gt;touches an entry still pending" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="1320" y="1400" width="320" height="80" as="geometry" /></mxCell><mxCell id="p9c57" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision or person · red hexagon = STOP, waits for you · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="p9c1"><mxGeometry x="40" y="2310" width="1600" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page10" name="10 Results record and cycle report"><mxGraphModel dx="1700" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1110" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p10c1" value="&lt;b&gt;10 Results record and cycle report&lt;/b&gt;" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p10c2" value="How every run is measured. Read down the spine: &lt;b&gt;each run&#x27;s results are recorded&lt;/b&gt; per test case, then summarised for the stories that ran; &lt;b&gt;npm run report:cycle&lt;/b&gt; rebuilds the report for any scope from the same records. The right-hand boxes are the rules it applies." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1620" height="40" as="geometry" /></mxCell><mxCell id="p10c3" value="&lt;b&gt;Any Playwright run&lt;/b&gt;&lt;br&gt;npm run regression · npx playwright test · the healer&#x27;s re-runs" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="460" height="54" as="geometry" /></mxCell><mxCell id="p10c4" value="&lt;b&gt;JSON reporter&lt;/b&gt;&lt;br&gt;writes test-results/results.json (local)" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="204" width="460" height="54" as="geometry" /></mxCell><mxCell id="p10c5" value="&lt;b&gt;Did a test end?&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;--list ends none&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160.0" y="288" width="220" height="100" as="geometry" /></mxCell><mxCell id="p10c6" value="&lt;b&gt;lib/cycleReporter.ts records the results&lt;/b&gt;&lt;br&gt;each test case that ran → its newest row in&lt;br&gt;specs/execution/automated-results.csv&lt;br&gt;TCID · Status · Executed On · Browser · Build · Spec&lt;br&gt;every other row kept; you never edit it" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="460" height="104" as="geometry" /></mxCell><mxCell id="p10c7" value="&lt;b&gt;AUTO_CYCLE_REPORT&lt;/b&gt;&lt;br&gt;&lt;b&gt;=false?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="140.0" y="552" width="260" height="100" as="geometry" /></mxCell><mxCell id="p10c8" value="&lt;b&gt;Writes the cycle summary&lt;/b&gt;&lt;br&gt;for the stories that ran, or npm run regression&#x27;s&lt;br&gt;selection (CYCLE_REPORT_SCOPE)&lt;br&gt;→ reports/, a new file each time; a failure never fails the run" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="682" width="460" height="90" as="geometry" /></mxCell><mxCell id="p10c9" value="&lt;b&gt;npm run report:cycle&lt;/b&gt;: by hand, or from the reporter&lt;br&gt;scope: --release · --epics · --stories (none = every plan)&lt;br&gt;--since &amp;lt;YYYY-MM-DD&amp;gt;: older results count as not run&lt;br&gt;--preview: the numbers as JSON, writes nothing&lt;br&gt;--strict: exits non-zero if a criterion is not met" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="812" width="460" height="104" as="geometry" /></mxCell><mxCell id="p10c10" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c3" target="p10c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c11" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c4" target="p10c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c12" value="yes" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c5" target="p10c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c13" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c6" target="p10c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c14" value="no" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c7" target="p10c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c15" value="later, any time" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#888888;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c8" target="p10c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c16" value="&lt;b&gt;default&lt;/b&gt;: reports/cycle-summary-…md&lt;br&gt;&lt;i&gt;local, git-ignored&lt;/i&gt;" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="250" height="54" as="geometry" /></mxCell><mxCell id="p10c17" value="&lt;b&gt;--formal&lt;/b&gt;, via /playwright-test-reporter&lt;br&gt;specs/execution/reports/&lt;br&gt;QA-Report_&amp;lt;app&amp;gt;_&amp;lt;scope&amp;gt;.md &lt;i&gt;(committed)&lt;/i&gt;" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="990" width="290" height="54" as="geometry" /></mxCell><mxCell id="p10c18" value="&lt;b&gt;--closure&lt;/b&gt;: specs/execution/closure/&lt;br&gt;&lt;i&gt;the cycle&#x27;s final report (committed)&lt;/i&gt;" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="620" y="990" width="260" height="54" as="geometry" /></mxCell><mxCell id="p10c19" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c9" target="p10c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="956" /><mxPoint x="165" y="956" /></Array></mxGeometry></mxCell><mxCell id="p10c20" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c9" target="p10c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="956" /><mxPoint x="455" y="956" /></Array></mxGeometry></mxCell><mxCell id="p10c21" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c9" target="p10c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="956" /><mxPoint x="750" y="956" /></Array></mxGeometry></mxCell><mxCell id="p10c22" value="&lt;b&gt;Also read the last run&lt;/b&gt;&lt;br&gt;npm run results:last: totals, failures grouped by cause&lt;br&gt;npm run context:sync: suggestions for context/, never written" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="196" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10c23" value="reads" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#888888;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c4" target="p10c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c24" value="&lt;b&gt;Nothing recorded&lt;/b&gt;&lt;br&gt;recording a listing would overwrite real results with Skipped" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="308" width="500" height="60" as="geometry" /></mxCell><mxCell id="p10c25" value="no" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c5" target="p10c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c26" value="&lt;b&gt;Branches never conflict&lt;/b&gt;&lt;br&gt;both results CSVs merge=union (.gitattributes): both sides&#x27; rows are kept&lt;br&gt;a test case with two rows: the newer Executed On wins&lt;br&gt;the next run writes the file back with one row each" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="430" width="500" height="80" as="geometry" /></mxCell><mxCell id="p10c27" value="&lt;b&gt;No cycle summary&lt;/b&gt;&lt;br&gt;the results are still recorded; npm run report:cycle rebuilds it" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="572" width="500" height="60" as="geometry" /></mxCell><mxCell id="p10c28" value="yes" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c7" target="p10c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c29" value="&lt;b&gt;Inputs it reads&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="680" width="500" height="260" as="geometry" /></mxCell><mxCell id="p10c30" value="specs/&amp;lt;ISSUE-KEY&amp;gt;.plan.md: test cases, priorities, AC → TCID links, Release, Epic" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="576" y="716" width="468" height="40" as="geometry" /></mxCell><mxCell id="p10c31" value="specs/execution/automated-results.csv: each automated case&#x27;s newest result" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="576" y="768" width="468" height="40" as="geometry" /></mxCell><mxCell id="p10c32" value="specs/execution/manual-results.csv: seeded Not Run by the planner, filled in by a tester" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="576" y="820" width="468" height="40" as="geometry" /></mxCell><mxCell id="p10c33" value="specs/defects/log/&amp;lt;entry id&amp;gt;.json: pending or raised = open, verified = fixed" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="576" y="872" width="468" height="40" as="geometry" /></mxCell><mxCell id="p10c34" value="reads" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#888888;dashed=1;exitX=0;exitY=0.7077;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c29" target="p10c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p10c35" value="&lt;b&gt;Exit criteria&lt;/b&gt;: PROJECT-PROFILE.md §10, mirrored in config/projectProfile.ts&lt;br&gt;Priority 1 test cases passing: 100%&lt;br&gt;Priority 2 test cases passing: 95%&lt;br&gt;Acceptance criteria with every test case passing: 100%&lt;br&gt;Open defects at P1: ≤ 0 · Open defects at P2: ≤ 0&lt;br&gt;Test cases not executed: ≤ 0&lt;br&gt;&lt;i&gt;each is Met or Not met; a person still decides the release&lt;/i&gt;" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="560" height="132" as="geometry" /></mxCell><mxCell id="p10c36" value="&lt;b&gt;An acceptance criterion&#x27;s state&lt;/b&gt;, from the plan&#x27;s AC → TCID links&lt;br&gt;Passing: every test case that verifies it passed (flaky counts)&lt;br&gt;Failing: one failed · Blocked by defect: one is test.fixme&lt;br&gt;Not executed: one has not run yet · Not covered: no test case" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="280" width="560" height="84" as="geometry" /></mxCell><mxCell id="p10c37" value="&lt;b&gt;The report&#x27;s header&lt;/b&gt;&lt;br&gt;Build under test: BUILD_UNDER_TEST at each run, from the Build column&lt;br&gt;Environment: TEST_ENVIRONMENT, a name, never the host&lt;br&gt;Browsers · generated by QA_TESTER_NAME (else the git user), UTC time&lt;br&gt;&lt;i&gt;more than one build: a warning to re-run what was tested on an older build before closing&lt;/i&gt;" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="392" width="560" height="104" as="geometry" /></mxCell><mxCell id="p10c38" value="&lt;b&gt;Every figure comes from the script&lt;/b&gt;&lt;br&gt;agents quote it and never count: the reporter asks the scope and format,&lt;br&gt;adds Jira titles (--jira) and written notes (--notes), never a number&lt;br&gt;the executor quotes --dry-run, results:last and --preview" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="524" width="560" height="84" as="geometry" /></mxCell><mxCell id="p10c39" value="&lt;b&gt;A cycle is many runs&lt;/b&gt;&lt;br&gt;the regression, the healer&#x27;s re-runs, a retest and the manual cases all fold into&lt;br&gt;the same records, so the report covers the whole cycle (specs/execution/README.md)" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1100" y="636" width="560" height="70" as="geometry" /></mxCell><mxCell id="p10c40" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start · blue = step or command · yellow diamond = decision · grey = nothing written · green = rule · orange = file · dashed = reads, or a later step" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1066" width="1620" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page11" name="11 Regression, reports and closure"><mxGraphModel dx="1640" dy="2370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2370" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p11c1" value="&lt;b&gt;11 Regression, reports and closure&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p11c2" value="Top to bottom: &lt;b&gt;/playwright-test-executor&lt;/b&gt;, or &lt;b&gt;npm run regression&lt;/b&gt; in a terminal, runs one client release&#x27;s tests on its release branch; &lt;b&gt;/playwright-test-reporter&lt;/b&gt; writes the formal report. Closing the cycle is &lt;b&gt;a person&#x27;s decision&lt;/b&gt;." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p11c3" value="/playwright-test-executor · npm run regression" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p11c4" value="&lt;b&gt;On the release branch&lt;/b&gt;&lt;br&gt;npm run story -- switch release/&amp;lt;x&amp;gt; --yes, asked first&lt;br&gt;develop for stories with no release yet" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="400" height="76" as="geometry" /></mxCell><mxCell id="p11c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c3" target="p11c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c6" value="&lt;b&gt;npm run regression&lt;br&gt;in a terminal?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="310" width="260" height="120" as="geometry" /></mxCell><mxCell id="p11c7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c4" target="p11c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c8" value="&lt;b&gt;The executor passes flags&lt;/b&gt;&lt;br&gt;--release · --epics · --stories&lt;br&gt;--all-tests · --browser · --grep&lt;br&gt;--headless · --dry-run · --yes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="340" height="100" as="geometry" /></mxCell><mxCell id="p11c9" value="no: the executor" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11c6" target="p11c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c10" value="&lt;b&gt;It asks in turn&lt;/b&gt;&lt;br&gt;which release: one, several, all, or no release yet&lt;br&gt;which tickets: all · by epic · chosen tickets&lt;br&gt;only tests tagged @Regression? yes by default" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="400" height="90" as="geometry" /></mxCell><mxCell id="p11c11" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c6" target="p11c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c12" value="&lt;b&gt;Shows the selection&lt;/b&gt;&lt;br&gt;tickets, and any with no spec yet · tests · browsers&lt;br&gt;the number of test runs · the build (BUILD_UNDER_TEST)&lt;br&gt;the executor shows it from a --dry-run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="600" width="400" height="90" as="geometry" /></mxCell><mxCell id="p11c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c10" target="p11c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c14" value="--dry-run first" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11c8" target="p11c12"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="645" /></Array></mxGeometry></mxCell><mxCell id="p11c15" value="&lt;b&gt;STOP: run it?&lt;/b&gt;&lt;br&gt;tests create data in a shared environment" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="730" width="440" height="70" as="geometry" /></mxCell><mxCell id="p11c16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c12" target="p11c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c17" value="Nothing run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="740" width="200" height="50" as="geometry" /></mxCell><mxCell id="p11c18" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11c15" target="p11c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c19" value="&lt;b&gt;Playwright runs the selection&lt;/b&gt;&lt;br&gt;the executor adds --headless and runs in the foreground,&lt;br&gt;story by story if it could outlast ten minutes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="840" width="400" height="76" as="geometry" /></mxCell><mxCell id="p11c20" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c15" target="p11c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c21" value="&lt;b&gt;Results recorded, cycle report written&lt;/b&gt;&lt;br&gt;automated-results.csv · reports/cycle-summary-…: page 10" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="956" width="400" height="60" as="geometry" /></mxCell><mxCell id="p11c22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c19" target="p11c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c23" value="&lt;b&gt;Commit the results&lt;/b&gt;&lt;br&gt;git commit -m &quot;test-run(&amp;lt;x&amp;gt;): regression,&lt;br&gt;&amp;lt;n&amp;gt; passed, &amp;lt;n&amp;gt; failed [run]&quot;&lt;br&gt;pushed only on a yes; a protected release/&amp;lt;x&amp;gt;: pushed to&lt;br&gt;test/regression-&amp;lt;x&amp;gt;, with a pull request into release/&amp;lt;x&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1056" width="400" height="100" as="geometry" /></mxCell><mxCell id="p11c24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c21" target="p11c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c25" value="&lt;b&gt;Heal, raise, record manual results&lt;/b&gt;&lt;br&gt;the executor&#x27;s hand-overs: pages 7 to 9" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1196" width="400" height="60" as="geometry" /></mxCell><mxCell id="p11c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c23" target="p11c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c27" value="&lt;b&gt;/playwright-test-reporter&lt;/b&gt;: started by the executor&#x27;s hand-over, or by you" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;fillColor=#f0f6fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="1296" width="820" height="704" as="geometry" /></mxCell><mxCell id="p11c28" value="&lt;b&gt;1 · Scope and format&lt;/b&gt;&lt;br&gt;story · several · epic · release; Markdown · HTML · PDF&lt;br&gt;the list is skipped when you already chose both" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1346" width="400" height="76" as="geometry" /></mxCell><mxCell id="p11c29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c25" target="p11c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c30" value="&lt;b&gt;2 · Jira titles and status, if connected&lt;/b&gt;&lt;br&gt;read only, into reports/.inputs/jira.json" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1452" width="400" height="60" as="geometry" /></mxCell><mxCell id="p11c31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c28" target="p11c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c32" value="&lt;b&gt;3 · npm run report:cycle -- … --preview&lt;/b&gt;&lt;br&gt;the figures as JSON; nothing written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1542" width="400" height="60" as="geometry" /></mxCell><mxCell id="p11c33" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c30" target="p11c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c34" value="&lt;b&gt;4 · The summary: reports/.inputs/notes.md&lt;/b&gt;&lt;br&gt;from the preview and the plan rows only&lt;br&gt;a failing case the plan marks as an assumption&lt;br&gt;is an open question for the BA" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1632" width="400" height="90" as="geometry" /></mxCell><mxCell id="p11c35" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c32" target="p11c34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c36" value="&lt;b&gt;5 · … --formal --format &amp;lt;chosen&amp;gt;&lt;/b&gt;&lt;br&gt;--jira reports/.inputs/jira.json&lt;br&gt;--notes reports/.inputs/notes.md · --by &amp;lt;name&amp;gt;&lt;br&gt;→ specs/execution/reports/QA-Report_&amp;lt;app&amp;gt;_&amp;lt;scope&amp;gt;.md&lt;br&gt;plus .html · .pdf when chosen&lt;br&gt;commit: test-report(&amp;lt;scope&amp;gt;): … [reported]" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1752" width="400" height="110" as="geometry" /></mxCell><mxCell id="p11c37" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c34" target="p11c36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c38" value="&lt;b&gt;STOP: post to Jira?&lt;/b&gt;&lt;br&gt;a test summary comment on each story, or&lt;br&gt;an on-hold note; shown first, posted on a yes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1892" width="440" height="80" as="geometry" /></mxCell><mxCell id="p11c39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c36" target="p11c38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c40" value="&lt;b&gt;One report per scope&lt;/b&gt;&lt;br&gt;QA-Report_&amp;lt;app&amp;gt;_release-2.26 · _FK-1304&lt;br&gt;_epic-FK-1301 · several keys joined with +&lt;br&gt;a new report replaces the last; git keeps&lt;br&gt;the history" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="1346" width="320" height="90" as="geometry" /></mxCell><mxCell id="p11c41" value="&lt;b&gt;When the report is written&lt;/b&gt;&lt;br&gt;the reporter hands back to the executor;&lt;br&gt;it never runs or offers a test run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="80" y="1456" width="320" height="70" as="geometry" /></mxCell><mxCell id="p11c42" value="&lt;b&gt;STOP: a person decides&lt;/b&gt;&lt;br&gt;whether the cycle closes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="2040" width="440" height="70" as="geometry" /></mxCell><mxCell id="p11c43" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c38" target="p11c42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c44" value="&lt;b&gt;npm run report:cycle -- --release &amp;lt;x&amp;gt; --closure&lt;/b&gt;&lt;br&gt;writes specs/execution/closure/; commit it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="2150" width="400" height="60" as="geometry" /></mxCell><mxCell id="p11c45" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c42" target="p11c44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c46" value="Cycle closed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="2250" width="320" height="40" as="geometry" /></mxCell><mxCell id="p11c47" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c44" target="p11c46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c48" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;each plan&#x27;s Release and Epic&lt;br&gt;tests/stories/&amp;lt;release&amp;gt;/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="70" as="geometry" /></mxCell><mxCell id="p11c49" value="&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;specs/execution/automated-results.csv&lt;br&gt;reports/ (local) · specs/execution/reports/&lt;br&gt;specs/execution/closure/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="220" width="340" height="80" as="geometry" /></mxCell><mxCell id="p11c50" value="&lt;b&gt;Before you run it&lt;/b&gt;&lt;br&gt;set BUILD_UNDER_TEST and TEST_ENVIRONMENT&lt;br&gt;in .env: the reports name both&lt;br&gt;retest the defects reported fixed (page 9)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="330" width="340" height="90" as="geometry" /></mxCell><mxCell id="p11c51" value="&lt;b&gt;Several releases, or all&lt;/b&gt;&lt;br&gt;a release&#x27;s own tickets test what changed;&lt;br&gt;the earlier releases&#x27; tests, what it might have broken" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="440" width="340" height="80" as="geometry" /></mxCell><mxCell id="p11c52" value="&lt;b&gt;Every figure from the scripts&lt;/b&gt;&lt;br&gt;the agents ask, enrich from Jira and word&lt;br&gt;the summary; they never count" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="540" width="340" height="80" as="geometry" /></mxCell><mxCell id="p11c53" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;a run without your yes to the selection&lt;br&gt;a run in the background&lt;br&gt;a comment on a bug, or a ticket&#x27;s status changed&lt;br&gt;a figure the scripts did not print" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="340" height="100" as="geometry" /></mxCell><mxCell id="p11c54" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · light blue band = the reporter&#x27;s steps · yellow = decision · red hexagon = STOP, waits for you · red box = hard rule · green = rule · orange = files read or written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2320" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page12" name="12 Git workflow"><mxGraphModel dx="1700" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p12c901" value="&lt;b&gt;12 Git workflow&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p12c902" value="Left to right: one release cycle across the branches of a project's QA repo (docs/GIT-WORKFLOW.md). &lt;b&gt;The agents run git; you answer.&lt;/b&gt; npm run story previews without --yes and never pushes, merges into a shared branch, deletes a branch or rewrites history." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1620" height="40" as="geometry" /></mxCell><mxCell id="p12c903" value="&lt;b&gt;main&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;what is live&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1620" height="90" as="geometry" /></mxCell><mxCell id="p12c904" value="&lt;b&gt;develop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;every finished story&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="1620" height="90" as="geometry" /></mxCell><mxCell id="p12c905" value="&lt;b&gt;release/&amp;lt;x&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one client release&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1620" height="90" as="geometry" /></mxCell><mxCell id="p12c906" value="&lt;b&gt;test/&amp;lt;KEY&amp;gt;-&amp;lt;desc&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one story&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="1620" height="90" as="geometry" /></mxCell><mxCell id="p12c907" value="&lt;b&gt;harness/&amp;lt;desc&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;harness changes&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f7f7;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1620" height="90" as="geometry" /></mxCell><mxCell id="p12c908" value="tests for what is live" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="132" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c909" value="created from main, once" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="237" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c910" value="&lt;b&gt;npm run story -- release-start 2.26&lt;/b&gt;&lt;br&gt;from the pulled develop" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="342" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c911" value="&lt;b&gt;npm run story -- start FK-1304&lt;/b&gt;&lt;br&gt;base you pick · fast-forward pull" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="447" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c912" value="plan · generate · review · run: each&lt;br&gt;agent commits its stage, then&lt;br&gt;&lt;b&gt;npm run story -- finish FK-1304&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="447" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c913" value="pull request [ready-to-merge]&lt;br&gt;reviewed and merged by the team" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="342" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c914" value="&lt;b&gt;npm run story -- switch release/2.26&lt;/b&gt;&lt;br&gt;regression on the release branch; when&lt;br&gt;it ships, the closure report, committed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="337" width="300" height="76" as="geometry" /></mxCell><mxCell id="p12c915" value="pull request release/2.26 → main" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1355" y="132" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c916" value="pull request release/2.26 → develop" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="237" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c917" value="the improver's change&lt;br&gt;pull request into develop" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="552" width="250" height="66" as="geometry" /></mxCell><mxCell id="p12c918" value="once" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p12c908" target="p12c909"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c919" value="release-start" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p12c909" target="p12c910"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c920" value="start" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p12c910" target="p12c911"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c921" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12c911" target="p12c912"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c922" value="push · PR (asked)" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12c912" target="p12c913"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c923" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12c913" target="p12c914"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c924" value="PR" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p12c914" target="p12c915"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c925" value="PR back" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p12c914" target="p12c916"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p12c926" value="harness/&amp;lt;desc&amp;gt; from develop" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12c909" target="p12c917"><mxGeometry x="-0.28" relative="1" as="geometry"><Array as="points"><mxPoint x="312" y="585" /></Array></mxGeometry></mxCell><mxCell id="p12c927" value="&lt;b&gt;Story start protocol&lt;/b&gt;&lt;br&gt;1 clean working tree&lt;br&gt;2 fetch&lt;br&gt;3 an existing branch → resume, never a second&lt;br&gt;4 you pick the base&lt;br&gt;5 fast-forward pull; diverged: stop&lt;br&gt;6 create test/&amp;lt;KEY&amp;gt;-&amp;lt;desc&amp;gt;&lt;br&gt;a regression: npm run story -- switch release/&amp;lt;x&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="310" height="180" as="geometry" /></mxCell><mxCell id="p12c928" value="&lt;b&gt;The merge rule&lt;/b&gt;&lt;br&gt;tests generated, reviewed and run, open&lt;br&gt;defects and fixme included, so the release&lt;br&gt;sees every known bug&lt;br&gt;no release yet: from and into develop,&lt;br&gt;listed as not in a release&lt;br&gt;waiting on a fix or an answer: a commit&lt;br&gt;ending [on-hold], the branch pushed (asked)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="370" y="660" width="310" height="180" as="geometry" /></mxCell><mxCell id="p12c929" value="&lt;b&gt;Commits: one line, git commit -m only&lt;/b&gt;&lt;br&gt;&amp;lt;type&amp;gt;(&amp;lt;KEY&amp;gt;): &amp;lt;what&amp;gt; [&amp;lt;stage&amp;gt;]&lt;br&gt;test-plan · test-gen · test-review · test-run ·&lt;br&gt;test-heal · defect · test-manual · test-report ·&lt;br&gt;context · harness&lt;br&gt;a regression&#x27;s key is the release&lt;br&gt;a narrow re-run: test-run(&amp;lt;KEY&amp;gt;): re-run&lt;br&gt;&amp;lt;TCIDs&amp;gt;, &amp;lt;n&amp;gt; passed, &amp;lt;n&amp;gt; failed [run]&lt;br&gt;a story on hold: … [on-hold]" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="310" height="180" as="geometry" /></mxCell><mxCell id="p12c930" value="&lt;b&gt;Records merge cleanly&lt;/b&gt;&lt;br&gt;the results CSVs merge with merge=union; the scripts read the newest row per test case&lt;br&gt;one file per defect in specs/defects/log/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="660" width="310" height="180" as="geometry" /></mxCell><mxCell id="p12c931" value="&lt;b&gt;Denied to agents&lt;/b&gt;&lt;br&gt;force-push, --force-with-lease too&lt;br&gt;push --delete · reset --hard · branch delete&lt;br&gt;rebase · commit --amend · clean&lt;br&gt;filter-branch · filter-repo&lt;br&gt;stash drop · stash clear&lt;br&gt;&lt;b&gt;Asked&lt;/b&gt;&lt;br&gt;push · merge · pull · checkout · switch&lt;br&gt;mv · cherry-pick · gh pr create · gh pr merge&lt;br&gt;protect main, develop, release/* on the remote" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1360" y="660" width="300" height="180" as="geometry" /></mxCell><mxCell id="p12c932" value="&lt;i&gt;Legend:&lt;/i&gt; blue = a step an agent runs · yellow = a pull request a person reviews · grey = harness change · green = rule · orange = convention · red = denied or asked" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1620" height="30" as="geometry" /></mxCell><mxCell id="p12c933" value="release/&amp;lt;x&amp;gt; protected on the remote:&lt;br&gt;results pushed to &lt;b&gt;test/regression-&amp;lt;x&amp;gt;&lt;/b&gt;,&lt;br&gt;pull request into release/&amp;lt;x&amp;gt; (asked)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="447" width="300" height="66" as="geometry" /></mxCell><mxCell id="p12c934" value="protected?" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="p12c914" target="p12c933"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page13" name="13 Guardrails"><mxGraphModel dx="1640" dy="1620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1620" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p13c1" value="&lt;b&gt;13 Guardrails&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p13c2" value="Each row is a kind of &lt;b&gt;agent tool call&lt;/b&gt;, the &lt;b&gt;rule in .claude/settings.json&lt;/b&gt; that matches it, and the &lt;b&gt;effect&lt;/b&gt;. Every Jira and Figma rule is written for both connections: the MCP entry and the plugin." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p13c3" value="Agent tool call" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="340" height="30" as="geometry" /></mxCell><mxCell id="p13c4" value="Rule in .claude/settings.json" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="500" height="30" as="geometry" /></mxCell><mxCell id="p13c5" value="Effect" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="260" height="30" as="geometry" /></mxCell><mxCell id="p13c6" value="&lt;b&gt;Read .env · Read .mcp.json&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="340" height="70" as="geometry" /></mxCell><mxCell id="p13c7" value="deny: Read(./.env) · Read(./.mcp.json)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="500" height="70" as="geometry" /></mxCell><mxCell id="p13c8" value="&lt;b&gt;BLOCK&lt;/b&gt;: agents never see&lt;br&gt;passwords or connection strings" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="170" width="260" height="70" as="geometry" /></mxCell><mxCell id="p13c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c6" target="p13c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c7" target="p13c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c11" value="&lt;b&gt;Database writes&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="340" height="70" as="geometry" /></mxCell><mxCell id="p13c12" value="deny: write_query · create_table · alter_table&lt;br&gt;drop_table · append_insight" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="500" height="70" 