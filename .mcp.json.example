{
  "//": "Copy to .mcp.json and fill in. .mcp.json is gitignored — the database entry carries a connection string.",
  "//  This is Claude Code's format. Other tools use the same servers in their own config file —": "",
  "//  see agents/README.md for where each one looks.": "",

  "//  playwright-test": "REQUIRED by the context-builder, generator and healer. Ships with @playwright/test — no separate install. Verified against `npx playwright init-agents`, which generates this exact entry.",
  "//  database": "OPTIONAL but high value. Lets agents introspect the real schema instead of asking you for every query. Use a READ-ONLY account against a QA database. Never production. See docs/MCP.md.",

  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"]
    },

    "database": {
      "command": "npx",
      "args": [
        "-y",
        "CHANGE_ME-your-sql-mcp-server",
        "--connection-string",
        "Server=CHANGE_ME;Database=CHANGE_ME;User Id=CHANGE_ME_READONLY;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=true"
      ]
    }
  }
}
