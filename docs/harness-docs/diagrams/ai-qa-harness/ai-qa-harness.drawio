ll=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8c35" target="p8c40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c42" value="&lt;b&gt;STOP — comment and status change?&lt;/b&gt;&lt;br&gt;transitions from the bug's own workflow;&lt;br&gt;you pick one, or none" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="1940" width="460" height="90" as="geometry" /></mxCell><mxCell id="p8c43" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8c40" target="p8c42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8c38" target="p8c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1980" /></Array></mxGeometry></mxCell><mxCell id="p8c45" value="Retest recorded" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="2070" width="320" height="40" as="geometry" /></mxCell><mxCell id="p8c46" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8c42" target="p8c45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c47" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;Jira bug, or specs/defects/defects.csv&lt;br&gt;test.fixme( markers in specs&lt;br&gt;the entry's status · raisedAt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="90" as="geometry" /></mxCell><mxCell id="p8c48" value="&lt;b&gt;Severity mapping&lt;/b&gt;&lt;br&gt;PROJECT-PROFILE.md §7; default&lt;br&gt;P1 → Highest/Critical · P2 → High/Major&lt;br&gt;P3 → Medium/Minor · P4 → Low/Low" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="240" width="340" height="90" as="geometry" /></mxCell><mxCell id="p8c49" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;edits, moves or comments on an existing&lt;br&gt;issue · writes a CSV row for a bug it&lt;br&gt;created · files an untraceable defect" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="350" width="340" height="90" as="geometry" /></mxCell><mxCell id="p8c50" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision or person · red hexagon = STOP, waits for you · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2160" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page9" name="10 Regression, reports and closure"><mxGraphModel dx="1640" dy="1668" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1668" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p9c1" value="&lt;b&gt;10 Regression, reports and closure&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p9c2" value="Top to bottom: &lt;b&gt;/playwright-test-executor&lt;/b&gt; — or &lt;b&gt;npm run regression&lt;/b&gt; in a terminal — runs one client release's tests on your machine; &lt;b&gt;/playwright-test-reporter&lt;/b&gt; writes the formal report. Closing the cycle is &lt;b&gt;a person's decision&lt;/b&gt;." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p9c3" value="/playwright-test-executor · npm run regression" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p9c4" value="&lt;b&gt;Running in&lt;br&gt;a terminal?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p9c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c3" target="p9c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c6" value="&lt;b&gt;Answers as flags&lt;/b&gt; — the executor's&lt;br&gt;--release · --epics · --stories&lt;br&gt;--all-tests · --browser · --dry-run · --yes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="340" height="80" as="geometry" /></mxCell><mxCell id="p9c7" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9c4" target="p9c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c8" value="&lt;b&gt;Pick the release&lt;/b&gt;&lt;br&gt;a number, several, all, or no release yet" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="400" height="60" as="geometry" /></mxCell><mxCell id="p9c9" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c4" target="p9c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c10" value="&lt;b&gt;Pick the tickets&lt;/b&gt;&lt;br&gt;all · by epic · chosen tickets" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="400" height="60" as="geometry" /></mxCell><mxCell id="p9c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c8" target="p9c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c12" value="&lt;b&gt;Only tests tagged @Regression?&lt;/b&gt; — default yes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="570" width="400" height="50" as="geometry" /></mxCell><mxCell id="p9c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c10" target="p9c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c14" value="&lt;b&gt;Show the selection&lt;/b&gt;&lt;br&gt;tickets · tests · browsers · build (BUILD_UNDER_TEST)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="670" width="400" height="60" as="geometry" /></mxCell><mxCell id="p9c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c12" target="p9c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9c6" target="p9c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="700" /></Array></mxGeometry></mxCell><mxCell id="p9c17" value="&lt;b&gt;STOP — Run it? [Y/n]&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="770" width="440" height="60" as="geometry" /></mxCell><mxCell id="p9c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c14" target="p9c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c19" value="Nothing run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="770" width="200" height="60" as="geometry" /></mxCell><mxCell id="p9c20" value="n" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9c17" target="p9c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c21" value="&lt;b&gt;Playwright runs the specs&lt;/b&gt;&lt;br&gt;the selection passed in CYCLE_REPORT_SCOPE" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="870" width="400" height="60" as="geometry" /></mxCell><mxCell id="p9c22" value="y" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c17" target="p9c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c23" value="&lt;b&gt;lib/cycleReporter.ts&lt;/b&gt;&lt;br&gt;records results in specs/execution/automated-results.csv&lt;br&gt;writes reports/cycle-summary-release-&amp;lt;release&amp;gt;-…md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="970" width="400" height="80" as="geometry" /></mxCell><mxCell id="p9c24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c21" target="p9c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c25" value="&lt;b&gt;Heal, raise, record manual results&lt;/b&gt;&lt;br&gt;the executor's hand-overs — pages 7–9" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1090" width="400" height="60" as="geometry" /></mxCell><mxCell id="p9c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c23" target="p9c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c27" value="&lt;b&gt;/playwright-test-reporter&lt;/b&gt; — scope and format asked&lt;br&gt;npm run report:cycle -- --release &amp;lt;x&amp;gt; --formal&lt;br&gt;each exit criterion from profile §10, met or not&lt;br&gt;→ specs/execution/reports/ · .md · .html · .pdf" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1190" width="400" height="90" as="geometry" /></mxCell><mxCell id="p9c28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c25" target="p9c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c29" value="&lt;b&gt;STOP — a person decides&lt;/b&gt;&lt;br&gt;whether the cycle closes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1300" width="440" height="80" as="geometry" /></mxCell><mxCell id="p9c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c27" target="p9c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c31" value="&lt;b&gt;npm run report:cycle -- … --closure&lt;/b&gt;&lt;br&gt;writes specs/execution/closure/ — commit it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1420" width="400" height="60" as="geometry" /></mxCell><mxCell id="p9c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c29" target="p9c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c33" value="Cycle closed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1520" width="320" height="40" as="geometry" /></mxCell><mxCell id="p9c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c31" target="p9c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p9c35" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;each plan's Release and Epic&lt;br&gt;tests/stories/&amp;lt;release&amp;gt;/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="80" as="geometry" /></mxCell><mxCell id="p9c36" value="&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;specs/execution/automated-results.csv&lt;br&gt;reports/ (local) · specs/execution/reports/&lt;br&gt;specs/execution/closure/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="230" width="340" height="88" as="geometry" /></mxCell><mxCell id="p9c37" value="&lt;b&gt;Before you run it&lt;/b&gt;&lt;br&gt;set BUILD_UNDER_TEST in .env&lt;br&gt;retest defects reported fixed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="320" width="340" height="80" as="geometry" /></mxCell><mxCell id="p9c38" value="&lt;b&gt;Whole cycle, not one run&lt;/b&gt;&lt;br&gt;the record keeps each case's latest result;&lt;br&gt;--since drops the last cycle's results" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="420" width="340" height="80" as="geometry" /></mxCell><mxCell id="p9c39" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · green = rule · orange = files read or written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1610" width="1560" height="30" as="geometry" /></mxCell><mxCell id="p9n901" value="&lt;b&gt;One report per scope&lt;/b&gt;&lt;br&gt;QA-Report_&amp;lt;app&amp;gt;_release-2.26 · _FK-1304 · _epic-FK-1301&lt;br&gt;a new report replaces the last; git keeps the history" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="520" width="340" height="90" as="geometry" /></mxCell><mxCell id="p9n902" value="&lt;b&gt;Every figure from the script&lt;/b&gt;&lt;br&gt;the agents ask, enrich from Jira and word the summary; they never count" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="630" width="340" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pageGit" name="11 Git workflow"><mxGraphModel dx="1700" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="pageGit-0" /><mxCell id="1" parent="pageGit-0" /><mxCell id="pGc901" value="&lt;b&gt;11 Git workflow&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="pGc902" value="Left to right: one release cycle across the branches of a project's QA repo (docs/GIT-WORKFLOW.md). &lt;b&gt;The agents run git; you answer.&lt;/b&gt; npm run story previews without --yes and never pushes, merges into a shared branch, deletes a branch or rewrites history." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1620" height="40" as="geometry" /></mxCell><mxCell id="pGc903" value="&lt;b&gt;main&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;what is live&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1620" height="90" as="geometry" /></mxCell><mxCell id="pGc904" value="&lt;b&gt;develop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;every finished story&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="1620" height="90" as="geometry" /></mxCell><mxCell id="pGc905" value="&lt;b&gt;release/&amp;lt;x&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one client release&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1620" height="90" as="geometry" /></mxCell><mxCell id="pGc906" value="&lt;b&gt;test/&amp;lt;KEY&amp;gt;-&amp;lt;desc&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one story&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="1620" height="90" as="geometry" /></mxCell><mxCell id="pGc907" value="&lt;b&gt;harness/&amp;lt;desc&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;harness changes&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f7f7;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1620" height="90" as="geometry" /></mxCell><mxCell id="pGc908" value="tests for what is live" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="132" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc909" value="created from main, once" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="237" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc910" value="&lt;b&gt;npm run story -- release-start 2.26&lt;/b&gt;&lt;br&gt;from the pulled develop" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="342" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc911" value="&lt;b&gt;npm run story -- start FK-1304&lt;/b&gt;&lt;br&gt;base you pick · fast-forward pull" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="447" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc912" value="plan · generate · review · run — each&lt;br&gt;agent commits its stage, then&lt;br&gt;&lt;b&gt;npm run story -- finish FK-1304&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="447" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc913" value="pull request [ready-to-merge]&lt;br&gt;reviewed and merged by the team" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="342" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc914" value="release ships: last regression&lt;br&gt;closure report, committed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="342" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc915" value="pull request release/2.26 → main" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="132" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc916" value="pull request release/2.26 → develop" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="237" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc917" value="the improver's change&lt;br&gt;pull request into develop" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="552" width="250" height="66" as="geometry" /></mxCell><mxCell id="pGc918" value="once" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pGc908" target="pGc909"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc919" value="release-start" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pGc909" target="pGc910"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc920" value="start" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pGc910" target="pGc911"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc921" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pGc911" target="pGc912"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc922" value="push · PR (asked)" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pGc912" target="pGc913"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc923" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pGc913" target="pGc914"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc924" value="PR" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pGc914" target="pGc915"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc925" value="PR back" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pGc914" target="pGc916"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc926" value="harness/&amp;lt;desc&amp;gt;" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pGc909" target="pGc917"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pGc927" value="&lt;b&gt;Story start protocol&lt;/b&gt;&lt;br&gt;1 clean working tree&lt;br&gt;2 fetch&lt;br&gt;3 an existing branch → resume, never a second&lt;br&gt;4 you pick the base&lt;br&gt;5 fast-forward pull — diverged: stop&lt;br&gt;6 create test/&amp;lt;KEY&amp;gt;-&amp;lt;desc&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="310" height="150" as="geometry" /></mxCell><mxCell id="pGc928" value="&lt;b&gt;The merge rule&lt;/b&gt;&lt;br&gt;tests generated, reviewed and run — open defects and fixme included, so the release sees every known bug&lt;br&gt;no release yet: from and into develop, listed as not in a release" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="370" y="660" width="310" height="150" as="geometry" /></mxCell><mxCell id="pGc929" value="&lt;b&gt;Commits — one line&lt;/b&gt;&lt;br&gt;&amp;lt;type&amp;gt;(&amp;lt;KEY&amp;gt;): &amp;lt;what&amp;gt; [&amp;lt;stage&amp;gt;]&lt;br&gt;test-plan · test-gen · test-review · test-run · test-heal · defect · test-manual · test-report · context · harness&lt;br&gt;a regression's key is the release" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="310" height="150" as="geometry" /></mxCell><mxCell id="pGc930" value="&lt;b&gt;Records merge cleanly&lt;/b&gt;&lt;br&gt;the results CSVs merge with merge=union; the scripts read the newest row per test case&lt;br&gt;one file per defect in specs/defects/log/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="660" width="310" height="150" as="geometry" /></mxCell><mxCell id="pGc931" value="&lt;b&gt;Denied to agents&lt;/b&gt;&lt;br&gt;force-push · reset --hard · branch delete · rebase · commit --amend · clean · stash drop&lt;br&gt;&lt;b&gt;Asked&lt;/b&gt;&lt;br&gt;push · merge · pull · checkout · gh pr create&lt;br&gt;protect main, develop, release/* on the remote" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1360" y="660" width="300" height="150" as="geometry" /></mxCell><mxCell id="pGc932" value="&lt;i&gt;Legend:&lt;/i&gt; blue = a step an agent runs · yellow = a pull request a person reviews · grey = harness change · green = rule · orange = convention · red = denied or asked" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1620" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page10" name="12 Guardrails"><mxGraphModel dx="1640" dy="1590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1590" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p10c1" value="&lt;b&gt;12 Guardrails&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p10c2" value="Each row is a kind of &lt;b&gt;agent tool call&lt;/b&gt;, the &lt;b&gt;rule in .claude/settings.json&lt;/b&gt; that matches it, and the &lt;b&gt;effect&lt;/b&gt;. Every Jira and Figma rule is written for both connections — the MCP entry and the plugin." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p10c3" value="Agent tool call" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="340" height="30" as="geometry" /></mxCell><mxCell id="p10c4" value="Rule in .claude/settings.json" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="500" height="30" as="geometry" /></mxCell><mxCell id="p10c5" value="Effect" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="260" height="30" as="geometry" /></mxCell><mxCell id="p10c6" value="&lt;b&gt;Read .env · Read .mcp.json&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10c7" value="deny: Read(./.env) · Read(./.mcp.json)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10c8" value="&lt;b&gt;BLOCK&lt;/b&gt; — agents never see&lt;br&gt;passwords or connection strings" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;f