# Allure
allure-report/
allure-results/

# Cycle reports written after every run — the top-level reports/ only. Formal reports
# (specs/execution/reports/) and the cycle's final report (specs/execution/closure/) are committed, as are
# specs/defects/ and specs/execution/. The leading slash matters: without it, specs/execution/reports/ is
# ignored too.
/reports/

# TypeScript build output
dist/

# Personal Claude Code settings — the shared guard rails are .claude/settings.json, which is committed.
.claude/settings.local.json
