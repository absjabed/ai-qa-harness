mily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="340" height="70" as="geometry" /></mxCell><mxCell id="p13c57" value="allow: Skill(playwright-test-healer) · Skill(playwright-defect-raiser)&lt;br&gt;Skill(playwright-test-reporter) · Skill(playwright-context-builder)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1080" width="500" height="70" as="geometry" /></mxCell><mxCell id="p13c58" value="&lt;b&gt;ALLOW&lt;/b&gt;: the executor hands&lt;br&gt;over without a prompt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1080" width="260" height="70" as="geometry" /></mxCell><mxCell id="p13c59" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c56" target="p13c57"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c60" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c57" target="p13c58"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c61" value="&lt;b&gt;Local git&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="340" height="70" as="geometry" /></mxCell><mxCell id="p13c62" value="allow: git status · log · diff · show · fetch · add&lt;br&gt;branch --list · branch --show-current&lt;br&gt;Bash(git commit -m:*): only the one-line form" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1170" width="500" height="70" as="geometry" /></mxCell><mxCell id="p13c63" value="&lt;b&gt;ALLOW&lt;/b&gt;: local git without a&lt;br&gt;prompt; any other commit&lt;br&gt;form is not pre-approved" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1170" width="260" height="70" as="geometry" /></mxCell><mxCell id="p13c64" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c61" target="p13c62"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c65" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c62" target="p13c63"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c66" value="&lt;b&gt;Harness scripts&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="340" height="70" as="geometry" /></mxCell><mxCell id="p13c67" value="allow: npm run story · env · regression · results:last&lt;br&gt;report:cycle · context:sync · defect:evidence" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1260" width="500" height="70" as="geometry" /></mxCell><mxCell id="p13c68" value="&lt;b&gt;ALLOW&lt;/b&gt;: the scripts run&lt;br&gt;without a prompt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1260" width="260" height="70" as="geometry" /></mxCell><mxCell id="p13c69" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c66" target="p13c67"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c70" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p13c67" target="p13c68"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p13c71" value="&lt;b&gt;.claude/settings.json&lt;/b&gt;&lt;br&gt;committed with the QA repo&lt;br&gt;allow 98 · ask 25 · deny 96&lt;br&gt;personal overrides go in&lt;br&gt;.claude/settings.local.json, gitignored&lt;br&gt;to change a guardrail, edit this file" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="170" width="320" height="130" as="geometry" /></mxCell><mxCell id="p13c72" value="read by Claude Code on every tool call" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p13c71" target="p13c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="155" /><mxPoint x="670" y="155" /></Array></mxGeometry></mxCell><mxCell id="p13c73" value="&lt;b&gt;Guardrails beyond the rules&lt;/b&gt;&lt;br&gt;allow rules apply only once the folder is trusted in Claude Code; deny and ask rules apply always&lt;br&gt;agents run each command plainly from the repo root, with no cd … &amp;amp;&amp;amp;, pipe or git -C: rules match how a command starts, so any of those turns an allowed command into a refused one&lt;br&gt;a refused call is reported once and never retried in another form&lt;br&gt;npm run env -- get &amp;lt;KEY&amp;gt; gives agents only allow-listed, non-secret settings · npm run env -- now is the one clock for a timestamp they record&lt;br&gt;agents log in only through tests/seeds/ and never handle a password (I4) · the healer&#x27;s expected-value guard · the reviewer sub-agent is limited to Glob · Grep · Read&lt;br&gt;lib/globalSetup.ts checks the application is reachable before every run · config/DbConnection.ts names missing settings and stops on refused logins&lt;br&gt;npm run check: typecheck · check:docs · check:trace · npm run export never overwrites · .gitignore keeps .env and .mcp.json out of git&lt;br&gt;the harness-improver never lowers the credential, database or delete protections · branch protection on the remote is what holds whatever is typed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1370" width="1560" height="170" as="geometry" /></mxCell><mxCell id="p13c74" value="&lt;i&gt;Legend:&lt;/i&gt; grey = agent tool call · blue = rule, or an ALLOW effect · red = BLOCK · yellow = ASK, or guardrails beyond the rules · green = the settings file · dashed = applies to every row" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page14" name="14 Harness improvement"><mxGraphModel dx="1640" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1500" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p14c1" value="&lt;b&gt;14 Harness improvement&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p14c2" value="Top to bottom: &lt;b&gt;/playwright-harness-improver&lt;/b&gt; changes this QA repo&#x27;s own harness when it does not behave as the team needs. It stops &lt;b&gt;twice&lt;/b&gt;, to confirm the problem and before changing anything, and records every change." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p14c3" value="/playwright-harness-improver" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p14c4" value="&lt;b&gt;Which mode?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p14c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c3" target="p14c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c6" value="&lt;b&gt;Note&lt;/b&gt;: record the problem only&lt;br&gt;&lt;b&gt;Summarize&lt;/b&gt;: list changes and&lt;br&gt;which are worth sending upstream" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="320" height="100" as="geometry" /></mxCell><mxCell id="p14c7" value="note · summarize" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p14c4" target="p14c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c8" value="Entry in HARNESS-CHANGES.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="350" width="240" height="40" as="geometry" /></mxCell><mxCell id="p14c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c6" target="p14c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c10" value="&lt;b&gt;1 · Get the evidence&lt;/b&gt;&lt;br&gt;one real case: what it was given, what it did,&lt;br&gt;what you expected" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="400" height="80" as="geometry" /></mxCell><mxCell id="p14c11" value="improve" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c4" target="p14c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c12" value="&lt;b&gt;1 · STOP: confirm the problem&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="440" height="60" as="geometry" /></mxCell><mxCell id="p14c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c10" target="p14c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c14" value="&lt;b&gt;2 · Find the layer&lt;/b&gt;&lt;br&gt;project facts → team conventions → agent instructions&lt;br&gt;→ invariants → scripts and config → guard rails" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="590" width="400" height="80" as="geometry" /></mxCell><mxCell id="p14c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c12" target="p14c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c16" value="&lt;b&gt;3 · Propose the smallest change&lt;/b&gt;&lt;br&gt;exact before and after · what else it touches&lt;br&gt;how to check it worked" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="710" width="400" height="80" as="geometry" /></mxCell><mxCell id="p14c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c14" target="p14c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c18" value="&lt;b&gt;Touches a&lt;br&gt;protection?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="830" width="260" height="120" as="geometry" /></mxCell><mxCell id="p14c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c16" target="p14c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c20" value="&lt;b&gt;Never changed&lt;/b&gt;&lt;br&gt;.env and secrets · database writes&lt;br&gt;or production · Jira deletes and admin&lt;br&gt;others only on an explicit, informed&lt;br&gt;yes, recorded under Protections" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="830" width="320" height="120" as="geometry" /></mxCell><mxCell id="p14c21" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p14c18" target="p14c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c22" value="&lt;b&gt;2 · STOP: wait for a yes&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="990" width="440" height="60" as="geometry" /></mxCell><mxCell id="p14c23" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c18" target="p14c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c24" value="explicit yes only" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p14c20" target="p14c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1020" /></Array></mxGeometry></mxCell><mxCell id="p14c25" value="&lt;b&gt;4 · Apply&lt;/b&gt;&lt;br&gt;on its own branch: harness/&amp;lt;desc&amp;gt; from develop (asked)&lt;br&gt;the change · the docs that restate it · npm run check" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1090" width="400" height="70" as="geometry" /></mxCell><mxCell id="p14c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c22" target="p14c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c27" value="&lt;b&gt;5 · Record it in HARNESS-CHANGES.md&lt;/b&gt;&lt;br&gt;problem · cause · change · check · status&lt;br&gt;upstream yes or no · protections&lt;br&gt;commit harness: &amp;lt;summary&amp;gt; [harness]&lt;br&gt;then push and a pull request into develop, each asked" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1200" width="400" height="100" as="geometry" /></mxCell><mxCell id="p14c28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c25" target="p14c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c29" value="Change made: check it on the same case" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1340" width="400" height="40" as="geometry" /></mxCell><mxCell id="p14c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p14c27" target="p14c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p14c31" value="&lt;b&gt;Self-audit before finishing&lt;/b&gt;&lt;br&gt;1 · the problem was confirmed first&lt;br&gt;2 · the change sits in the cause's layer&lt;br&gt;3 · docs updated · npm run check passes&lt;br&gt;4 · protections kept, or the yes recorded&lt;br&gt;5 · HARNESS-CHANGES.md has the entry&lt;br&gt;6 · no claim the agent now behaves differently" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="p14c32" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;the harness file the change belongs in&lt;br&gt;the docs that restate it&lt;br&gt;HARNESS-CHANGES.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="590" width="340" height="90" as="geometry" /></mxCell><mxCell id="p14c33" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step or mode · yellow = decision · red hexagon = STOP, waits for you · red box = hard rule · green = checklist · orange = files written · dashed = only with an explicit yes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>
