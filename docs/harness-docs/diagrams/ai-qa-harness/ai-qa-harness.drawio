;" edge="1" parent="1" source="p1c13" target="p1n901"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 Agent pattern"><mxGraphModel dx="1600" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="920" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2c1" value="&lt;b&gt;2 Agent pattern&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p2c2" value="Each agent is reached through a &lt;b&gt;slash command&lt;/b&gt; (blue) that only points at its &lt;b&gt;canonical definition&lt;/b&gt; (green). One agent is also a &lt;b&gt;sub-agent&lt;/b&gt; (purple) that the planner and generator start in a fresh context." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1520" height="40" as="geometry" /></mxCell><mxCell id="p2c3" value="Slash command — .claude/commands/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="380" height="30" as="geometry" /></mxCell><mxCell id="p2c4" value="Definition — agents/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="330" height="30" as="geometry" /></mxCell><mxCell id="p2c5" value="Sub-agent — .claude/agents/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="240" height="30" as="geometry" /></mxCell><mxCell id="p2c6" value="&lt;b&gt;/playwright-context-builder&lt;/b&gt; · opus · effort xhigh" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2c7" value="agents/playwright-context-builder.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2c8" value="follows" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c6" target="p2c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c9" value="&lt;b&gt;/playwright-test-planner&lt;/b&gt; · opus · effort xhigh" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2c10" value="agents/playwright-test-planner.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="230" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c9" target="p2c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c12" value="&lt;b&gt;/playwright-test-generator&lt;/b&gt; · opus" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2c13" value="agents/playwright-test-generator.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2c14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c12" target="p2c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c15" value="&lt;b&gt;/playwright-test-reviewer&lt;/b&gt; · opus" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2c16" value="agents/playwright-test-reviewer.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c15" target="p2c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c18" value="&lt;b&gt;/playwright-test-healer&lt;/b&gt; · opus" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2c19" value="agents/playwright-test-healer.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="410" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2c20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c18" target="p2c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c21" value="&lt;b&gt;/playwright-defect-raiser&lt;/b&gt; · opus" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2c22" value="agents/playwright-defect-raiser.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c21" target="p2c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c24" value="&lt;b&gt;/playwright-harness-improver&lt;/b&gt; · opus" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2c25" value="agents/playwright-harness-improver.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="530" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c24" target="p2c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c27" value="&lt;b&gt;playwright-test-reviewer&lt;/b&gt;&lt;br&gt;tools: Glob · Grep · Read&lt;br&gt;model: opus&lt;br&gt;read-only · never asks&lt;br&gt;returns must fix / consider" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="940" y="230" width="240" height="160" as="geometry" /></mxCell><mxCell id="p2c28" value="offers review" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2c10" target="p2c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c29" value="always" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2c13" target="p2c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c30" value="loads" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;exitX=0;exitY=0.875;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2c27" target="p2c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2c31" value="&lt;b&gt;PROJECT-PROFILE.md&lt;/b&gt;&lt;br&gt;read first by all nine agents" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="380" height="60" as="geometry" /></mxCell><mxCell id="p2c32" value="&lt;b&gt;TEST-AUTHORING-INVARIANTS.md&lt;/b&gt; — I1–I8&lt;br&gt;read by six agents; the defect-raiser, executor and reporter read only the profile" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="730" width="680" height="60" as="geometry" /></mxCell><mxCell id="p2c33" value="&lt;b&gt;Who starts the sub-agent&lt;/b&gt;&lt;br&gt;planner — offers a plan review before saving&lt;br&gt;generator — reviews every spec it writes,&lt;br&gt;unless you say no review&lt;br&gt;you — /playwright-test-reviewer any time" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="170" width="340" height="120" as="geometry" /></mxCell><mxCell id="p2c34" value="&lt;b&gt;Command vs sub-agent&lt;/b&gt;&lt;br&gt;a command runs in your session and can ask;&lt;br&gt;allowed-tools only pre-approves&lt;br&gt;the sub-agent starts fresh, limited to&lt;br&gt;Glob · Grep · Read, and returns findings" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="310" width="340" height="120" as="geometry" /></mxCell><mxCell id="p2c35" value="&lt;b&gt;One definition per agent&lt;/b&gt;&lt;br&gt;edit agents/&amp;lt;name&amp;gt;.md, never a wrapper&lt;br&gt;wrappers stay at 8 lines or fewer&lt;br&gt;and point at it&lt;br&gt;npm run check:docs fails an unpaired&lt;br&gt;or grown wrapper" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="450" width="340" height="120" as="geometry" /></mxCell><mxCell id="p2c36" value="&lt;b&gt;Real limits live in .claude/settings.json&lt;/b&gt;&lt;br&gt;allow · ask · deny rules apply to every agent&lt;br&gt;agents never read .env or .mcp.json" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="590" width="340" height="100" as="geometry" /></mxCell><mxCell id="p2c37" value="&lt;i&gt;Legend:&lt;/i&gt; blue = slash command or note on running · green = definition, knowledge or rule · purple = sub-agent · red = hard rule · solid = command follows its definition · dashed = starts or loads" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1520" height="30" as="geometry" /></mxCell><mxCell id="p2n901" value="&lt;b&gt;/playwright-test-executor&lt;/b&gt; · opus" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="380" height="40" as="geometry" /></mxCell><mxCell id="p2n902" value="agents/playwright-test-executor.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="590" width="330" height="40" as="geometry" /></mxCell><mxCell id="p2n903" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2n901" target="p2n902"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2n904" value="&lt;b&gt;/playwright-test-reporter&lt;/b&gt; · sonnet" 