rcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="530" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10c29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c26" target="p10c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c27" target="p10c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c31" value="&lt;b&gt;Jira reads&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10c32" value="allow: getJiraIssue · searchJiraIssuesUsingJql&lt;br&gt;metadata · transitions · statuses · discover · executeRead" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10c33" value="&lt;b&gt;ALLOW&lt;/b&gt; — read without&lt;br&gt;a prompt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="620" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c31" target="p10c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c35" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c32" target="p10c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c36" value="&lt;b&gt;Database reads&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10c37" value="allow: read_query · list_tables · describe_table" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="710" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10c38" value="&lt;b&gt;ALLOW&lt;/b&gt; — read-only queries" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="710" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10c39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c36" target="p10c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c40" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c37" target="p10c38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c41" value="&lt;b&gt;Keep defect evidence&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10c42" value="allow: Bash(npm run defect:evidence:*)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="800" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10c43" value="&lt;b&gt;ALLOW&lt;/b&gt; — the healer copies&lt;br&gt;screenshots without a prompt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="800" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c41" target="p10c42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c45" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c42" target="p10c43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c46" value="&lt;b&gt;.claude/settings.json&lt;/b&gt;&lt;br&gt;committed with the QA repo&lt;br&gt;allow 63 · ask 25 · deny 96&lt;br&gt;personal overrides go in&lt;br&gt;.claude/settings.local.json — gitignored" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1280" y="170" width="320" height="160" as="geometry" /></mxCell><mxCell id="p10c47" value="read by Claude Code on every tool call" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p10c46" target="p10c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="160" /><mxPoint x="670" y="160" /></Array></mxGeometry></mxCell><mxCell id="p10c48" value="&lt;b&gt;Guardrails beyond the rules&lt;/b&gt;&lt;br&gt;agents log in only through tests/seeds/ and never handle a password (I4) · the healer's expected-value guard · the reviewer sub-agent is limited to Glob · Grep · Read&lt;br&gt;lib/globalSetup.ts checks the application is reachable before every run · config/DbConnection.ts names missing settings and fails fast on refused logins&lt;br&gt;npm run check — typecheck · check:docs · check:trace · npm run export never overwrites, and .gitignore keeps .env and .mcp.json out of git&lt;br&gt;the harness-improver never lowers the credential, database or delete protections · npm run env -- get reads only allow-listed, non-secret settings · branch protection on the remote is what holds whatever is typed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="1560" height="150" as="geometry" /></mxCell><mxCell id="p10c49" value="&lt;i&gt;Legend:&lt;/i&gt; grey = agent tool call · blue = rule, or an ALLOW effect · red = BLOCK · yellow = ASK, or guardrails beyond the rules · green = the settings file · dashed = applies to every row" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="1560" height="30" as="geometry" /></mxCell><mxCell id="p10n901" value="&lt;b&gt;Destructive git&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10n902" value="deny: push --force · push --delete · reset --hard&lt;br&gt;branch -D / -d · rebase · commit --amend · clean · stash drop" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="890" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10n903" value="&lt;b&gt;BLOCK&lt;/b&gt; — no history rewritten,&lt;br&gt;no branch deleted" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="890" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10n904" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n901" target="p10n902"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n905" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n902" target="p10n903"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n906" value="&lt;b&gt;git push · merge · pull · checkout · switch&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10n907" value="ask: those, plus gh pr create · gh pr merge" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="980" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10n908" value="&lt;b&gt;ASK&lt;/b&gt; — a person approves&lt;br&gt;anything that reaches the remote" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="980" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10n909" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n906" target="p10n907"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n910" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n907" target="p10n908"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n911" value="&lt;b&gt;git status · log · diff · add · commit&lt;br&gt;npm run story · env · regression · context:sync&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10n912" value="allow: Bash(git status:*) · Bash(git commit -m:*) …&lt;br&gt;Bash(npm run story:*) · Bash(npm run env:*) …" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1070" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10n913" value="&lt;b&gt;ALLOW&lt;/b&gt; — local git and the&lt;br&gt;harness scripts run without a prompt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1070" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10n914" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n911" target="p10n912"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n915" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n912" target="p10n913"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n916" value="&lt;b&gt;Figma writes&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10n917" value="deny: use_figma · create_new_file · generate_… · upload_assets&lt;br&gt;html_to_figma · Code Connect · plugin and shader writes · Weave" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1160" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10n918" value="&lt;b&gt;BLOCK&lt;/b&gt; — QA never&lt;br&gt;changes a design" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1160" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10n919" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n916" target="p10n917"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n920" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n917" target="p10n918"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n921" value="&lt;b&gt;Figma reads&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10n922" value="allow: whoami · get_metadata · get_design_context&lt;br&gt;get_screenshot · get_variable_defs · get_comments …" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1250" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10n923" value="&lt;b&gt;ALLOW&lt;/b&gt; — designs read&lt;br&gt;without a prompt" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1250" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10n924" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n921" target="p10n922"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10n925" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10n922" target="p10n923"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page11" name="13 Harness improvement"><mxGraphModel dx="1640" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1450" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p11c1" value="&lt;b&gt;13 Harness improvement&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p11c2" value="Top to bottom: &lt;b&gt;/playwright-harness-improver&lt;/b&gt; changes this QA repo's own harness when it does not behave as the team needs. It stops &lt;b&gt;twice&lt;/b&gt; — to confirm the problem, and before changing anything — and records every change." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p11c3" value="/playwright-harness-improver" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p11c4" value="&lt;b&gt;Which mode?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p11c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c3" target="p11c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c6" value="&lt;b&gt;Note&lt;/b&gt; — record the problem only&lt;br&gt;&lt;b&gt;Summarize&lt;/b&gt; — list changes and&lt;br&gt;which are worth sending upstream" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="320" height="100" as="geometry" /></mxCell><mxCell id="p11c7" value="note · summarize" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11c4" target="p11c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c8" value="Entry in HARNESS-CHANGES.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="350" width="240" height="40" as="geometry" /></mxCell><mxCell id="p11c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c6" target="p11c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c10" value="&lt;b&gt;1 · Get the evidence&lt;/b&gt;&lt;br&gt;one real case: what it was given, what it did,&lt;br&gt;what you expected" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="400" height="80" as="geometry" /></mxCell><mxCell id="p11c11" value="improve" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c4" target="p11c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c12" value="&lt;b&gt;1 · STOP — confirm the problem&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="440" height="60" as="geometry" /></mxCell><mxCell id="p11c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c10" target="p11c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c14" value="&lt;b&gt;2 · Find the layer&lt;/b&gt;&lt;br&gt;project facts → team conventions → agent instructions&lt;br&gt;→ invariants → scripts and config → guard rails" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="590" width="400" height="80" as="geometry" /></mxCell><mxCell id="p11c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c12" target="p11c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c16" value="&lt;b&gt;3 · Propose the smallest change&lt;/b&gt;&lt;br&gt;exact before and after · what else it touches&lt;br&gt;how to check it worked" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="710" width="400" height="80" as="geometry" /></mxCell><mxCell id="p11c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c14" target="p11c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c18" value="&lt;b&gt;Touches a&lt;br&gt;protection?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="830" width="260" height="120" as="geometry" /></mxCell><mxCell id="p11c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c16" target="p11c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c20" value="&lt;b&gt;Never changed&lt;/b&gt;&lt;br&gt;.env and secrets · database writes&lt;br&gt;or production · Jira deletes and admin&lt;br&gt;others only on an explicit, informed&lt;br&gt;yes, recorded under Protections" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="830" width="320" height="120" as="geometry" /></mxCell><mxCell id="p11c21" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11c18" target="p11c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c22" value="&lt;b&gt;2 · STOP — wait for a yes&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="990" width="440" height="60" as="geometry" /></mxCell><mxCell id="p11c23" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c18" target="p11c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c24" value="explicit yes only" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11c20" target="p11c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1020" /></Array></mxGeometry></mxCell><mxCell id="p11c25" value="&lt;b&gt;4 · Apply&lt;/b&gt;&lt;br&gt;the change · the docs that restate it · npm run check" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1090" width="400" height="60" as="geometry" /></mxCell><mxCell id="p11c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c22" target="p11c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c27" value="&lt;b&gt;5 · Record it in HARNESS-CHANGES.md&lt;/b&gt;&lt;br&gt;problem · cause · change · check · status&lt;br&gt;upstream yes or no · protections" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1190" width="400" height="80" as="geometry" /></mxCell><mxCell id="p11c28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c25" target="p11c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c29" value="Change made — check it on the same case" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1310" width="400" height="40" as="geometry" /></mxCell><mxCell id="p11c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11c27" target="p11c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p11c31" value="&lt;b&gt;Self-audit before finishing&lt;/b&gt;&lt;br&gt;1 · the problem was confirmed first&lt;br&gt;2 · the change sits in the cause's layer&lt;br&gt;3 · docs updated · npm run check passes&lt;br&gt;4 · protections kept, or the yes recorded&lt;br&gt;5 · HARNESS-CHANGES.md has the entry&lt;br&gt;6 · no claim the agent now behaves differently" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="p11c32" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;the harness file the change belongs in&lt;br&gt;the docs that restate it&lt;br&gt;HARNESS-CHANGES.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="590" width="340" height="90" as="geometry" /></mxCell><mxCell id="p11c33" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step or mode · yellow = decision · red hexagon = STOP, waits for you · red box = hard rule · green = checklist · orange = files written · dashed = only with an explicit yes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>