80" y="750" width="240" height="40" as="geometry" /></mxCell><mxCell id="p3c54" value="npm run context:sync" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="750" width="240" height="40" as="geometry" /></mxCell><mxCell id="p3c55" value="npm run defect:evidence" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="750" width="240" height="40" as="geometry" /></mxCell><mxCell id="p3c56" value="npm run test:ui" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="750" width="240" height="40" as="geometry" /></mxCell><mxCell id="p3c57" value="&lt;i&gt;Legend:&lt;/i&gt; blue = stage or entry point · orange = file written · grey = utility · solid = next stage · dashed = writes, or the next stage reads it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1620" height="30" as="geometry" /></mxCell><mxCell id="p3n901" value="&lt;b&gt;Git, at every stage&lt;/b&gt; — docs/GIT-WORKFLOW.md&lt;br&gt;npm run story -- start &amp;lt;KEY&amp;gt; before planning: the base branch you pick, fast-forward pulled → test/&amp;lt;KEY&amp;gt;-&amp;lt;desc&amp;gt; · each agent commits its own stage: &amp;lt;type&amp;gt;(&amp;lt;KEY&amp;gt;): &amp;lt;what&amp;gt; [&amp;lt;stage&amp;gt;] · npm run story -- finish once the tests are generated, reviewed and run → a pull request into release/&amp;lt;x&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1640" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4 Context-builder setup"><mxGraphModel dx="1640" dy="2730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2730" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4c1" value="&lt;b&gt;4 Context-builder setup&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p4c2" value="Top to bottom: &lt;b&gt;/playwright-context-builder&lt;/b&gt; runs once at setup. It checks the logins, Jira and Figma first, then inventories, roams the app read-only and writes drafts — stopping at &lt;b&gt;seven checkpoints&lt;/b&gt; for you. Side branches go right; a failed login exits left." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p4c3" value="/playwright-context-builder" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p4c4" value="&lt;b&gt;0a · Roles&lt;/b&gt;&lt;br&gt;shows the role keys; if they are wrong, sets the roles,&lt;br&gt;baseline role, profile §2 and one login file per role" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="210" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c3" target="p4c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c6" value="&lt;b&gt;0b · Logins&lt;/b&gt;&lt;br&gt;test_run on tests/seeds/ — passed, or the cause per role&lt;br&gt;offers to fill the LoginPage, DashboardPage and&lt;br&gt;Logout selectors from the page" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="400" height="90" as="geometry" /></mxCell><mxCell id="p4c7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c4" target="p4c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c8" value="&lt;b&gt;Every role&lt;br&gt;logs in?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="460" width="260" height="120" as="geometry" /></mxCell><mxCell id="p4c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c6" target="p4c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c10" value="&lt;b&gt;STOP — ask&lt;/b&gt;&lt;br&gt;carry on with the others,&lt;br&gt;or stop to fix the logins" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="340" height="100" as="geometry" /></mxCell><mxCell id="p4c11" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c8" target="p4c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c12" value="&lt;b&gt;0c · Jira and Figma&lt;/b&gt;&lt;br&gt;Jira: Atlassian plugin or tracker MCP — fetches one story you know exists&lt;br&gt;Figma, if connected: one read" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="620" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c13" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c8" target="p4c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c14" value="&lt;b&gt;1 · STOP — review the preflight&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="740" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c12" target="p4c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c16" value="&lt;b&gt;1 · Inventory&lt;/b&gt;&lt;br&gt;asks by name what exists and can be reached&lt;br&gt;documents go in context/sources/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="840" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c14" target="p4c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c18" value="&lt;b&gt;2 · STOP — correct the inventory&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="960" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c16" target="p4c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c20" value="&lt;b&gt;2 · Roam the app, read-only&lt;/b&gt;&lt;br&gt;signed out first: tests/seed.spec.ts&lt;br&gt;then each role: tests/seeds/&amp;lt;role&amp;gt;.spec.ts&lt;br&gt;no forms submitted, nothing created" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1060" width="400" height="90" as="geometry" /></mxCell><mxCell id="p4c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c18" target="p4c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c22" value="&lt;b&gt;3 · STOP — review the module map&lt;/b&gt;&lt;br&gt;and what each role cannot do" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1190" width="440" height="80" as="geometry" /></mxCell><mxCell id="p4c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c20" target="p4c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c24" value="&lt;b&gt;3 · Read the sources&lt;/b&gt;&lt;br&gt;specs and rules → Invariants, each with its source&lt;br&gt;test cases → Existing coverage · defects → Caveats&lt;br&gt;Jira: live if connected, or a CSV export&lt;br&gt;guides → vocabulary · designs → Design intent" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1310" width="400" height="100" as="geometry" /></mxCell><mxCell id="p4c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c22" target="p4c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c26" value="&lt;b&gt;Database reachable&lt;br&gt;and MCP connected?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1450" width="260" height="120" as="geometry" /></mxCell><mxCell id="p4c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c24" target="p4c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c28" value="&lt;b&gt;4 · Introspect, read-only&lt;/b&gt;&lt;br&gt;list and describe tables&lt;br&gt;confirm surprises against real rows" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="1470" width="320" height="80" as="geometry" /></mxCell><mxCell id="p4c29" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c26" target="p4c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c30" value="&lt;b&gt;5 · Write context/BASELINE.md&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1610" width="400" height="50" as="geometry" /></mxCell><mxCell id="p4c31" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c26" target="p4c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c28" target="p4c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1640" /></Array></mxGeometry></mxCell><mxCell id="p4c33" value="&lt;b&gt;4 · STOP — approve the baseline&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1710" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c30" target="p4c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c35" value="&lt;b&gt;6 · Draft profile §2–4 and module tags&lt;/b&gt;&lt;br&gt;drafts for a person to correct" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1810" width="400" height="60" as="geometry" /></mxCell><mxCell id="p4c36" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c33" target="p4c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c37" value="&lt;b&gt;5 · STOP — show each draft first&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1910" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c38" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c35" target="p4c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c39" value="&lt;b&gt;7 · Draft navigation plans and the matrix&lt;/b&gt;&lt;br&gt;one plan per role&lt;br&gt;each matrix cell Verified or Not tested here" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2020" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c40" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c37" target="p4c39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c41" value="&lt;b&gt;6 · STOP — show the drafts&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="2130" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c42" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c39" target="p4c41"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c43" value="&lt;b&gt;8 · Deep context for named areas&lt;/b&gt;&lt;br&gt;context/&amp;lt;area&amp;gt;.md: rules, states,&lt;br&gt;recipes, verification queries" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2240" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c41" target="p4c43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c45" value="&lt;b&gt;7 · STOP — show each document&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="2350" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c46" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c43" target="p4c45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c47" value="&lt;b&gt;Self-audit (blocking)&lt;/b&gt;&lt;br&gt;nothing invented · provenance recorded&lt;br&gt;no writes to the app or database · no credentials&lt;br&gt;known unknowns populated" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2460" width="400" height="90" as="geometry" /></mxCell><mxCell id="p4c48" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c45" target="p4c47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c49" value="Baseline written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="2590" width="320" height="40" as="geometry" /></mxCell><mxCell id="p4c50" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c47" target="p4c49"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c51" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;context/BASELINE.md · context/&amp;lt;area&amp;gt;.md&lt;br&gt;PROJECT-PROFILE.md §2–4&lt;br&gt;specs/UserFlowsUserRolePermissions/&lt;br&gt;specs/RegressionTags/regression-tags.md&lt;br&gt;with your yes: config/projectProfile.ts,&lt;br&gt;tests/seeds/, pages/LoginPage.ts,&lt;br&gt;pages/DashboardPage.ts" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="150" as="geometry" /></mxCell><mxCell id="p4c52" value="&lt;b&gt;The governing rule&lt;/b&gt;&lt;br&gt;record what you established, and name&lt;br&gt;what you did not — known unknowns&lt;br&gt;are a deliverable, not a failure" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="340" height="90" as="geometry" /></mxCell><mxCell id="p4c53" value="&lt;b&gt;When it runs&lt;/b&gt;&lt;br&gt;once at setup; again, scoped to one area&lt;br&gt;or role, when a module, role or&lt;br&gt;navigation changes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="410" width="340" height="90" as="geometry" /></mxCell><mxCell id="p4c54" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;reads .env or types a credential&lt;br&gt;submits a form or changes data&lt;br&gt;writes to the database&lt;br&gt;fills a matrix cell by symmetry" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="520" width="340" height="100" as="geometry" /></mxCell><mxCell id="p4c55" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2670" width="1560" height="30" as="geometry" /></mxCell><mxCell id="p4n901" value="&lt;b&gt;Context sync&lt;/b&gt; — after a run, from the executor&lt;br&gt;npm run context:sync, then only what you agree to: verified marks · a caveat naming an open defect · an unknown answered&lt;br&gt;never a new rule" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="340" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="5 Test planning"><mxGraphModel dx="1640" dy="2358" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2358" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p5c1" value="&lt;b&gt;5 Test planning&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p5c2" value="Top to bottom: &lt;b&gt;/playwright-test-planner &amp;lt;KEY&amp;gt;&lt;/b&gt; turns one story into a plan. No browser — it grounds everything in the repo. It stops at &lt;b&gt;seven checkpoints&lt;/b&gt;; the independent plan review (purple) runs only if you say yes." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p5c3" value="/playwright-test-planner &amp;lt;KEY&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p5c4" value="&lt;b&gt;Story key&lt;br&gt;present and valid?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p5c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c3" target="p5c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c6" value="&lt;b&gt;STOP — ask for the key&lt;/b&gt;&lt;br&gt;no key-less mode (I8)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="340" height="80" as="geometry" /></mxCell><mxCell id="p5c7" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c4" target="p5c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c8" value="&lt;b&gt;Read the story&lt;/b&gt;&lt;br&gt;fetched from Jira by its key, or pasted&lt;br&gt;release = fix version · epic = parent epic, or asked&lt;br&gt;optional: existing test cases · the Figma frames it links" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="400" height="90" as="geometry" /></mxCell><mxCell id="p5c9" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c4" target="p5c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c10" value="&lt;b&gt;1 · STOP — confirm story, AC, gaps&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c8" target="p5c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c12" value="&lt;b&gt;Read PROJECT-PROFILE.md and the invariants&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="400" height="50" as="geometry" /></mxCell><mxCell id="p5c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c10" target="p5c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c14" value="&lt;b&gt;2 · STOP — approve the conventions&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c12" target="p5c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c16" value="&lt;b&gt;Inspect the repo, no live browser&lt;/b&gt;&lt;br&gt;context/ · navigation plans · pages/&lt;br&gt;lib/BaseTest.ts · data/ · existing specs" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="810" width="400" height="80" as="geometry" /></mxCell><mxCell id="p5c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c14" target="p5c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c18" value="&lt;b&gt;3 · STOP — approve reuse or cut scope&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="920" width="460" height="60" as="geometry" /></mxCell><mxCell id="p5c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c16" target="p5c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c20" value="&lt;b&gt;Analyse flows, design scenarios&lt;/b&gt;&lt;br&gt;EP · BVA · decision table · state transition&lt;br&gt;pairwise · error guessing&lt;br&gt;then the completeness critique" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1030" width="400" height="90" as="geometry" /></mxCell><mxCell id="p5c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c18" target="p5c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c22" value="&lt;b&gt;4 · STOP — approve scenario titles&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1160" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c20" target="p5c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c24" value="&lt;b&gt;New page object&lt;br&gt;or fixture needed?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1260" width="260" height="120" as="geometry" /></mxCell><mxCell id="p5c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c22" target="p5c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c26" value="&lt;b&gt;5 · STOP — approve&lt;/b&gt;&lt;br&gt;what is new and where" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="1280" width="320" height="80" as="geometry" /></mxCell><mxCell id="p5c27" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c24" target="p5c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c28" value="&lt;b&gt;Structure each scenario&lt;/b&gt;&lt;br&gt;TCID heading · Given/When/Then · Expected Result&lt;br&gt;Data · Priority by fixed questions" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1420" width="400" height="80" as="geometry" /></mxCell><mxCell id="p5c29" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c24" target="p5c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c26" target="p5c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1460" /></Array></mxGeometry></mxCell><mxCell id="p5c31" value="&lt;b&gt;6 · STOP — approve the full plan&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1540" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c28" target="p5c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c33" value="&lt;b&gt;Run the&lt;br&gt;independent review?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1640" width="260" height="120" as="geometry" /></mxCell><mxCell id="p5c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c31" target="p5c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c35" value="&lt;b&gt;playwright-test-reviewer&lt;/b&gt;&lt;br&gt;plan review, fresh context&lt;br&gt;must fix folded in · consider shown" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="1660" width="320" height="80" as="geometry" /></mxCell><mxCell id="p5c36" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c33" target="p5c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c37" value="&lt;b&gt;Self-audit before saving (blocking)&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1800" width="400" height="50" as="geometry" /></mxCell><mxCell id="p5c38" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c33" target="p5c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c35" target="p5c37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1820" /></Array></mxGeometry></mxCell><mxCell id="p5c40" value="&lt;b&gt;Save the plan&lt;/b&gt;&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1890" width="400" height="60" as="geometry" /></mxCell><mxCell id="p5c41" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c37" target="p5c40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c42" value="&lt;b&gt;7 · STOP — approve the CSV rows&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1990" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c43" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c40" target="p5c42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c44" value="&lt;b&gt;Write the CSV and manual rows&lt;/b&gt;&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.csv · Not Run rows in&lt;br&gt;specs/execution/manual-results.csv" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2100" width="400" height="80" as="geometry" /></mxCell><mxCell id="p5c45" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c42" target="p5c44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c46" value="Plan saved" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="2210" width="320" height="40" as="geometry" /></mxCell><mxCell id="p5c47" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c44" target="p5c46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c48" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.md&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.csv&lt;br&gt;specs/execution/manual-results.csv" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="90" as="geometry" /></mxCell><mxCell id="p5c49" value="&lt;b&gt;TCIDs are assigned here only&lt;/b&gt;&lt;br&gt;&amp;lt;KEY&amp;gt;-TC&amp;lt;NNN&amp;gt;, never renumbered;&lt;br&gt;a dropped scenario is marked Retired" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="240" width="340" height="80" as="geometry" /></mxCell><mxCell id="p5c50" value="&lt;b&gt;Priority by fixed questions&lt;/b&gt;&lt;br&gt;data loss or no workaround → P1&lt;br&gt;only coverage of an AC → P1&lt;br&gt;secondary role or workaround → P2&lt;br&gt;otherwise → P3" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="340" height="100" as="geometry" /></mxCell><mxCell id="p5c51" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;plans without a story key&lt;br&gt;edits, comments on or moves the story&lt;br&gt;guesses a selector or a data key" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="460" width="340" height="90" as="geometry" /></mxCell><mxCell id="p5c52" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · purple = sub-agent · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2300" width="1560" height="30" as="geometry" /></mxCell><mxCell id="p5n901" value="&lt;b&gt;Designs are intent, not rules&lt;/b&gt;&lt;br&gt;read sparingly through figma, cited in the plan's Design line&lt;br&gt;design-only details marked (design: &amp;lt;node&amp;gt;) · a design that disagrees with an AC is raised at checkpoint 1" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="570" width="340" height="120" as="geometry" /></mxCell><mxCell id="p5n902" value="&lt;b&gt;Git first&lt;/b&gt;&lt;br&gt;npm run story -- start &amp;lt;KEY&amp;gt;: clean tree · fetch · resume or the base you pick · fast-forward pull&lt;br&gt;commits test-plan(&amp;lt;KEY&amp;gt;) … [planned] · [plan-reviewed]" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="710" width="340" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6 Test generation"><mxGraphModel dx="1640" dy="1940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1940" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p6c1" value="&lt;b&gt;6 Test generation&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p6c2" value="Top to bottom: &lt;b&gt;/playwright-test-generator&lt;/b&gt; drives the real browser through every plan step before it writes code, then has the spec &lt;b&gt;reviewed by default&lt;/b&gt; (purple). Missing inputs exit left; questions branch right." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p6c3" value="/playwright-test-generator specs/&amp;lt;KEY&amp;gt;.plan.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="400" height="40" as="geometry" /></mxCell><mxCell id="p6c4" value="&lt;b&gt;Plan named and&lt;br&gt;scenario has a TCID?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p6c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c3" target="p6c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c6" value="&lt;b&gt;STOP — ask&lt;/b&gt;&lt;br&gt;which plan; or add the&lt;br&gt;scenario to the plan —&lt;br&gt;never mints a TCID" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="340" height="100" as="geometry" /></mxCell><mxCell id="p6c7" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c4" target="p6c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c8" value="&lt;b&gt;Read the profile, invariants, context/&amp;lt;area&amp;gt;.md&lt;/b&gt;&lt;br&gt;and the navigation plans for each role" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="400" height="60" as="geometry" /></mxCell><mxCell id="p6c9" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c4" target="p6c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c10" value="&lt;b&gt;generator_setup_page with the seed&lt;/b&gt;&lt;br&gt;tests/seeds/&amp;lt;role&amp;gt;.spec.ts, or tests/seed.spec.ts&lt;br&gt;for a signed-out scenario — never logs in by hand" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="400" height="80" as="geometry" /></mxCell><mxCell id="p6c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c8" target="p6c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c12" value="&lt;b&gt;Drive each step live (browser_* tools)&lt;/b&gt;&lt;br&gt;map to page object · fixture · data key&lt;br&gt;scope any ambiguous locator (I7)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="590" width="400" height="80" as="geometry" /></mxCell><mxCell id="p6c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c10" target="p6c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c14" value="&lt;b&gt;Page object&lt;br&gt;method exists?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="710" width="260" height="120" as="geometry" /></mxCell><mxCell id="p6c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c12" target="p6c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c16" value="&lt;b&gt;STOP — confirm&lt;/b&gt;&lt;br&gt;the new page object&lt;br&gt;or method" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="320" height="100" as="geometry" /></mxCell><mxCell id="p6c17" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c14" target="p6c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c18" value="&lt;b&gt;DB check needs a&lt;br&gt;query not in&lt;br&gt;sql_queries.ts?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="870" width="260" height="140" as="geometry" /></mxCell><mxCell id="p6c19" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c14" target="p6c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c20" value="then implements it" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c16" target="p6c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="630" /></Array></mxGeometry></mxCell><mxCell id="p6c21" value="&lt;b&gt;STOP — ask for the SQL&lt;/b&gt;&lt;br&gt;never writes it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="320" height="80" as="geometry" /></mxCell><mxCell id="p6c22" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c18" target="p6c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c23" value="&lt;b&gt;generator_read_log:&lt;br&gt;an action per step?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1050" width="260" height="120" as="geometry" /></mxCell><mxCell id="p6c24" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c18" target="p6c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c21" target="p6c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1110" /></Array></mxGeometry></mxCell><mxCell id="p6c26" value="no — drive again" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c23" target="p6c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="1110" /><mxPoint x="410" y="510" /></Array></mxGeometry></mxCell><mxCell id="p6c27" value="&lt;b&gt;STOP — confirm the target file path&lt;/b&gt;&lt;br&gt;tests/stories/&amp;lt;release&amp;gt;/ · &amp;lt;EPIC-KEY&amp;gt;/ · root" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1210" width="520" height="80" as="geometry" /></mxCell><mxCell id="p6c28" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c23" target="p6c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c29" value="&lt;b&gt;Self-audit before writing (blocking)&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1330" width="400" height="50" as="geometry" /></mxCell><mxCell id="p6c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c27" target="p6c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c31" value="&lt;b&gt;generator_write_test&lt;/b&gt;&lt;br&gt;title = TCID + summary · one test.step per plan line&lt;br&gt;priority tags + module tag" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1420" width="400" height="80" as="geometry" /></mxCell><mxCell id="p6c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c29" target="p6c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c33" value="&lt;b&gt;playwright-test-reviewer — test review&lt;/b&gt;&lt;br&gt;fresh context, by default; skipped only on no review" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1540" width="400" height="60" as="geometry" /></mxCell><mxCell id="p6c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c31" target="p6c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c35" value="&lt;b&gt;must fix&lt;br&gt;findings?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1640" width="260" height="120" as="geometry" /></mxCell><mxCell id="p6c36" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c33" target="p6c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c37" value="&lt;b&gt;Fix them&lt;/b&gt;&lt;br&gt;re-drive the step live if needed&lt;br&gt;re-review once; show what still fails" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="1660" width="320" height="80" as="geometry" /></mxCell><mxCell id="p6c38" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c35" target="p6c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c39" value="Spec written and reviewed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1800" width="320" height="40" as="geometry" /></mxCell><mxCell id="p6c40" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c35" target="p6c39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c41" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c37" target="p6c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1820" /></Array></mxGeometry></mxCell><mxCell id="p6c42" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;tests/stories/&amp;lt;release&amp;gt;/&amp;lt;KEY&amp;gt;.spec.ts&lt;br&gt;pages/&amp;lt;Name&amp;gt;Page.ts · lib/BaseTest.ts&lt;br&gt;data/sql_queries.ts — SQL you supply&lt;br&gt;regression-tags.md — a tag you approve" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="100" as="geometry" /></mxCell><mxCell id="p6c43" value="&lt;b&gt;Tags from the plan's priority&lt;/b&gt;&lt;br&gt;P1 → @Regression @Priority1&lt;br&gt;P2 → @Regression @Priority2&lt;br&gt;P3 → @Priority3 · plus a module tag" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="250" width="340" height="90" as="geometry" /></mxCell><mxCell id="p6c44" value="&lt;b&gt;File path&lt;/b&gt;&lt;br&gt;a release → tests/stories/&amp;lt;release&amp;gt;/&lt;br&gt;no release, an epic → &amp;lt;EPIC-KEY&amp;gt;/&lt;br&gt;neither → tests/stories/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="360" width="340" height="90" as="geometry" /></mxCell><mxCell id="p6c45" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;writes a step it did not drive live&lt;br&gt;reads .env or logs in by hand&lt;br&gt;invents a module tag or SQL" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="470" width="340" height="90" as="geometry" /></mxCell><mxCell id="p6c46" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · purple = sub-agent · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1880" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pageRun" name="7 Running tests"><mxGraphModel dx="1640" dy="1760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1760" background="#ffffff" math="0" shadow="0"><root><mxCell id="pageRun-0" /><mxCell id="1" parent="pageRun-0" /><mxCell id="pRc901" value="&lt;b&gt;7 Running tests&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="pRc902" value="Top to bottom: &lt;b&gt;/playwright-test-executor&lt;/b&gt; runs one story's tests or a release's regression, and sees the run through — failures to the healer, defects to the defect-raiser, the report to the reporter. It never starts without your yes, and every figure it gives comes from the scripts." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="pRc903" value="/playwright-test-executor" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="pRc904" value="&lt;b&gt;1 · What to run&lt;/b&gt;&lt;br&gt;story run: every test of the chosen stories&lt;br&gt;regression run: a release, epics or tickets — @Regression by default" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="210" width="400" height="90" as="geometry" /></mxCell><mxCell id="pRc905" value="&lt;b&gt;2 · Dry run&lt;/b&gt;&lt;br&gt;npm run regression -- … --dry-run&lt;br&gt;tickets · test count · browsers · build — nothing recorded" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="340" width="400" height="80" as="geometry" /></mxCell><mxCell id="pRc906" value="&lt;b&gt;STOP — run it?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="440" height="60" as="geometry" /></mxCell><mxCell id="pRc907" value="Nothing run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="460" width="200" height="60" as="geometry" /></mxCell><mxCell id="pRc908" value="&lt;b&gt;3 · Run&lt;/b&gt; — headless, in the background&lt;br&gt;npm run regression -- … --yes&lt;br&gt;results recorded · commit test-run(&amp;lt;KEY&amp;gt;) … [run]" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="570" width="400" height="80" as="geometry" /></mxCell><mxCell id="pRc909" value="&lt;b&gt;4 · npm run results:last&lt;/b&gt;&lt;br&gt;totals · failures grouped by spec and error&lt;br&gt;manual cases still Not Run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="690" width="400" height="80" as="geometry" /></mxCell><mxCell id="pRc910" value="&lt;b&gt;Failures?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="810" width="260" height="120" as="geometry" /></mxCell><mxCell id="pRc911" value="&lt;b&gt;STOP — heal all · these groups&lt;br&gt;skip · stop&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="830" width="320" height="80" as="geometry" /></mxCell><mxCell id="pRc912" value="&lt;b&gt;/playwright-test-healer&lt;/b&gt; with that scope&lt;br&gt;then results:last and the defect log&lt;br&gt;read again" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="950" width="320" height="80" as="geometry" /></mxCell><mxCell id="pRc913" value="&lt;b&gt;5 · Pending defects?&lt;/b&gt;&lt;br&gt;offer /playwright-defect-raiser" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1080" width="400" height="60" as="geometry" /></mxCell><mxCell id="pRc914" value="&lt;b&gt;6 · Manual cases Not Run?&lt;/b&gt;&lt;br&gt;enter results now, or leave them" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1180" width="400" height="60" as="geometry" /></mxCell><mxCell id="pRc915" value="&lt;b&gt;7 · The report&lt;/b&gt;&lt;br&gt;offer /playwright-test-reporter, this run's scope" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1280" width="400" height="60" as="geometry" /></mxCell><mxCell id="pRc916" value="&lt;b&gt;8 · npm run context:sync&lt;/b&gt;&lt;br&gt;rules verified or contradicted · unknowns a case may answer&lt;br&gt;apply? → /playwright-context-builder" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1380" width="400" height="80" as="geometry" /></mxCell><mxCell id="pRc917" value="&lt;b&gt;9 · npm run story -- status&lt;/b&gt;&lt;br&gt;may merge → finish · push · pull request, each asked&lt;br&gt;waiting → commit [on-hold], push asked" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1500" width="400" height="80" as="geometry" /></mxCell><mxCell id="pRc918" value="Run finished" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1620" width="320" height="40" as="geometry" /></mxCell><mxCell id="pRc919" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc903" target="pRc904"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc920" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc904" target="pRc905"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc921" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc905" target="pRc906"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc922" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc908" target="pRc909"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc923" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc909" target="pRc910"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc924" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc913" target="pRc914"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc925" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc914" target="pRc915"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc926" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc915" target="pRc916"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc927" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc916" target="pRc917"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc928" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc917" target="pRc918"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc929" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pRc906" target="pRc907"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc930" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc906" target="pRc908"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc931" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pRc910" target="pRc911"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc932" value="heal" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pRc911" target="pRc912"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc933" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pRc912" target="pRc913"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc934" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pRc910" target="pRc913"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="pRc935" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;test-results/results.json · the results CSVs&lt;br&gt;specs/defects/log/ · the plans&lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;manual results you give · its results commit" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="120" as="geometry" /></mxCell><mxCell id="pRc936" value="&lt;b&gt;Every figure from the scripts&lt;/b&gt;&lt;br&gt;--dry-run · results:last · the defect log · manual results — read again after every hand-over" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="270" width="340" height="90" as="geometry" /></mxCell><mxCell id="pRc937" value="&lt;b&gt;Resuming&lt;/b&gt;&lt;br&gt;a session that ended mid-run starts from results:last and carries on at step 4" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="380" width="340" height="80" as="geometry" /></mxCell><mxCell id="pRc938" value="&lt;b&gt;The generator hands over&lt;/b&gt;&lt;br&gt;after a clean test review it asks: run these tests now?" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="480" width="340" height="80" as="geometry" /></mxCell><mxCell id="pRc939" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;runs without your yes&lt;br&gt;fixes a test or a locator&lt;br&gt;files a bug or posts to Jira&lt;br&gt;counts a figure itself · reads .env" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="580" width="340" height="120" as="geometry" /></mxCell><mxCell id="pRc940" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · red box = never · green = rule · orange = files read or written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1700" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page7" name="8 Healing failures"><mxGraphModel dx="1640" dy="1366" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1366" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p7c1" value="&lt;b&gt;8 Healing failures&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p7c2" value="Top to bottom: &lt;b&gt;/playwright-test-healer&lt;/b&gt; fixes test-side failures itself and stops for you only on a genuine application bug, or when a fix would change &lt;b&gt;what a test expects&lt;/b&gt;. The fix loop is on the right." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p7c3" value="/playwright-test-healer &amp;lt;KEY · spec · TCID&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="400" height="40" as="geometry" /></mxCell><mxCell id="p7c4" value="&lt;b&gt;Told what&lt;br&gt;to heal?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p7c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c3" target="p7c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c6" value="&lt;b&gt;STOP — confirm what to heal&lt;/b&gt;&lt;br&gt;lists the last run's failures&lt;br&gt;from test-results/results.json" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="340" height="100" as="geometry" /></mxCell><mxCell id="p7c7" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7c4" target="p7c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c8" value="&lt;b&gt;test_run on the tests in scope&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="400" height="50" as="geometry" /></mxCell><mxCell id="p7c9" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c4" target="p7c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c10" value="&lt;b&gt;test_debug each failure&lt;/b&gt;&lt;br&gt;snapshot · console · network · read-only DB query" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="400" height="60" as="geometry" /></mxCell><mxCell id="p7c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c8" target="p7c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c12" value="&lt;b&gt;Genuine application&lt;br&gt;bug?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reproduced twice, test-side&lt;br&gt;causes ruled out&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="570" width="280" height="140" as="geometry" /></mxCell><mxCell id="p7c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c10" target="p7c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c14" value="&lt;b&gt;Fix on the test side&lt;/b&gt;&lt;br&gt;selector · wait · locator scope&lt;br&gt;in the page object or testData.ts" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="600" width="320" height="80" as="geometry" /></mxCell><mxCell id="p7c15" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7c12" target="p7c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c16" value="&lt;b&gt;STOP — expected-value guard&lt;/b&gt;&lt;br&gt;changes what the test expects?&lt;br&gt;plan agrees → defect candidate" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="710" width="340" height="90" as="geometry" /></mxCell><mxCell id="p7c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c14" target="p7c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c18" value="&lt;b&gt;STOP — after 3 attempts&lt;/b&gt;&lt;br&gt;summarise and ask" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="830" width="320" height="80" as="geometry" /></mxCell><mxCell id="p7c19" value="still failing" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c16" target="p7c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c20" value="rerun" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7c16" target="p7c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="760" /><mxPoint x="1230" y="400" /></Array></mxGeometry></mxCell><mxCell id="p7c21" value="&lt;b&gt;STOP — confirm the defect&lt;/b&gt;&lt;br&gt;and its severity, P1–P4" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="750" width="440" height="80" as="geometry" /></mxCell><mxCell id="p7c22" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c12" target="p7c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c23" value="&lt;b&gt;Log it&lt;/b&gt;&lt;br&gt;specs/defects/log/&amp;lt;entry id&amp;gt;.json · status pending" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="870" width="400" height="60" as="geometry" /></mxCell><mxCell id="p7c24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c21" target="p7c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c25" value="&lt;b&gt;npm run defect:evidence&lt;/b&gt;&lt;br&gt;keeps screenshots in specs/defects/evidence/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="970" width="400" height="60" as="geometry" /></mxCell><mxCell id="p7c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c23" target="p7c25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c27" value="&lt;b&gt;Run the healed specs once more&lt;/b&gt;&lt;br&gt;npx playwright test — results reach the record" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1070" width="400" height="60" as="geometry" /></mxCell><mxCell id="p7c28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c25" target="p7c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c29" value="Fixed tests, or defects pending" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1170" width="320" height="40" as="geometry" /></mxCell><mxCell id="p7c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c27" target="p7c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c31" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;pages/ · data/testData.ts — fixes&lt;br&gt;specs/defects/log/&amp;lt;entry id&amp;gt;.json&lt;br&gt;specs/defects/evidence/&amp;lt;entry id&amp;gt;/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="950" width="340" height="90" as="geometry" /></mxCell><mxCell id="p7c32" value="&lt;b&gt;Defects found by hand&lt;/b&gt;&lt;br&gt;a tester gives the TCID and what happened;&lt;br&gt;same confirmation, logged as foundBy manual" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="1060" width="340" height="80" as="geometry" /></mxCell><mxCell id="p7c33" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;changes a TCID&lt;br&gt;skips, fixmes or deletes a test to pass&lt;br&gt;guesses database state without access" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="1160" width="340" height="90" as="geometry" /></mxCell><mxCell id="p7c34" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="1560" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page8" name="9 Defects and retest"><mxGraphModel dx="1640" dy="2218" grid="1" gridSize="10" guides="1" tooltips="1" conn