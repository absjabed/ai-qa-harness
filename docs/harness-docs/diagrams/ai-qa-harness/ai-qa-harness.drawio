55;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c12" target="p10c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c16" value="&lt;b&gt;Jira deletes&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="340" height="70" as="geometry" /></mxCell><mxCell id="p10c17" value="deny: deleteJiraIssue · deleteJiraComment&lt;br&gt;deleteJiraIssueAttachment · executeDestructive" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="350" width="500" height="70" as="geometry" /></mxCell><mxCell id="p10c18" value="&lt;b&gt;BLOCK&lt;/b&gt; — nothing deletes&lt;br&gt;Jira data" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="350" width="260" height="70" as="geometry" /></mxCell><mxCell id="p10c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c16" target="p10c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p10c17" target="p10c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p10c21" value="&lt;b&gt;Jira admin and project changes&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="340" height="70" as="geometry" /></mxCell