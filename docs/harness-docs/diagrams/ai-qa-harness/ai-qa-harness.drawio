et="p3c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="248" y="380" /></Array></mxGeometry></mxCell><mxCell id="p3c39" value="Release: line picks the folder" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#888888;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3c18" target="p3c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="521" y="330" /><mxPoint x="635" y="330" /></Array></mxGeometry></mxCell><mxCell id="p3c40" value="&lt;b&gt;Other entry points&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;fontColor=#333333;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1880" height="230" as="geometry" /></mxCell><mxCell id="p3c41" value="&lt;b&gt;Set-up, once per project (pages 1 and 4)&lt;/b&gt;&lt;br&gt;npm run prep: the pre-setup folder · npm run export: the harness copy&lt;br&gt;/playwright-context-builder: learns the app, writes context/" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="658" width="446" height="80" as="geometry" /></mxCell><mxCell id="p3c42" value="&lt;b&gt;/playwright-test-reviewer&lt;/b&gt;&lt;br&gt;an independent, read-only review of any plan&lt;br&gt;against its ticket, or of a spec against its plan" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="522" y="658" width="446" height="80" as="geometry" /></mxCell><mxCell id="p3c43" value="&lt;b&gt;/playwright-test-healer: retest&lt;/b&gt;&lt;br&gt;raised defects, once fixed: the test passes twice&lt;br&gt;→ active again, the entry verified (page 9)" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="988" y="658" width="446" height="80" as="geometry" /></mxCell><mxCell id="p3c44" value="&lt;b&gt;/playwright-harness-improver&lt;/b&gt;&lt;br&gt;when the harness does not fit how the team works:&lt;br&gt;the smallest change, made on a yes (page 14)" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1454" y="658" width="446" height="80" as="geometry" /></mxCell><mxCell id="p3c45" value="retest reads it" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;strokeColor=#888888;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3004;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3c28" target="p3c43"><mxGeometry x="0.64" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1122" y="380" /></Array></mxGeometry></mxCell><mxCell id="p3c46" value="&lt;b&gt;Utilities (any time)&lt;/b&gt;&lt;br&gt;npm run story -- status · results:last · report:cycle · context:sync · env -- get / now · check · docs · defect:evidence · test:ui · report" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="56" y="764" width="1844" height="60" as="geometry" /></mxCell><mxCell id="p3c47" value="&lt;i&gt;Legend:&lt;/i&gt; yellow = agent that interviews you · blue = harness command · grey = outside the harness · orange = file written · solid = next stage · dashed = writes, or a labelled hand-off" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="864" width="1880" height="20" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page4" name="4 Context-builder setup"><mxGraphModel dx="1640" dy="2730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2730" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p4c1" value="&lt;b&gt;4 Context-builder setup&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p4c2" value="Top to bottom: &lt;b&gt;/playwright-context-builder&lt;/b&gt; runs once at setup. It checks the logins, Jira and Figma first, then inventories, roams the app read-only and writes drafts, stopping at &lt;b&gt;seven checkpoints&lt;/b&gt; for you. Side branches go right; a failed login exits left." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p4c3" value="/playwright-context-builder" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p4c4" value="&lt;b&gt;0a · Roles&lt;/b&gt;&lt;br&gt;shows the role keys; if they are wrong, sets the roles,&lt;br&gt;baseline role, profile §2 and one login file per role" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="210" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c3" target="p4c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c6" value="&lt;b&gt;0b · Logins&lt;/b&gt;&lt;br&gt;test_run on tests/seeds/: passed, or the cause per role&lt;br&gt;offers to fill the LoginPage, DashboardPage and&lt;br&gt;Logout selectors from the page" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="400" height="90" as="geometry" /></mxCell><mxCell id="p4c7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c4" target="p4c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c8" value="&lt;b&gt;Every role&lt;br&gt;logs in?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="460" width="260" height="120" as="geometry" /></mxCell><mxCell id="p4c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c6" target="p4c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c10" value="&lt;b&gt;STOP: ask&lt;/b&gt;&lt;br&gt;carry on with the others,&lt;br&gt;or stop to fix the logins" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="340" height="100" as="geometry" /></mxCell><mxCell id="p4c11" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c8" target="p4c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c12" value="&lt;b&gt;0c · Jira and Figma&lt;/b&gt;&lt;br&gt;Jira: Atlassian plugin or tracker MCP, fetches one story you know exists&lt;br&gt;Figma, if connected: one read" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="620" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c13" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c8" target="p4c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c14" value="&lt;b&gt;1 · STOP: review the preflight&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="740" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c12" target="p4c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c16" value="&lt;b&gt;1 · Inventory&lt;/b&gt;&lt;br&gt;asks by name what exists and can be reached&lt;br&gt;documents go in context/sources/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="840" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c14" target="p4c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c18" value="&lt;b&gt;2 · STOP: correct the inventory&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="960" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c16" target="p4c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c20" value="&lt;b&gt;2 · Roam the app, read-only&lt;/b&gt;&lt;br&gt;signed out first: tests/seed.spec.ts&lt;br&gt;then each role: tests/seeds/&amp;lt;role&amp;gt;.spec.ts&lt;br&gt;no forms submitted, nothing created" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1060" width="400" height="90" as="geometry" /></mxCell><mxCell id="p4c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c18" target="p4c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c22" value="&lt;b&gt;3 · STOP: review the module map&lt;/b&gt;&lt;br&gt;and what each role cannot do" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1190" width="440" height="80" as="geometry" /></mxCell><mxCell id="p4c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c20" target="p4c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c24" value="&lt;b&gt;3 · Read the sources&lt;/b&gt;&lt;br&gt;specs and rules → Invariants, each with its source&lt;br&gt;test cases → Existing coverage · defects → Caveats&lt;br&gt;Jira: live if connected, or a CSV export&lt;br&gt;guides → vocabulary · designs → Design intent" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1310" width="400" height="100" as="geometry" /></mxCell><mxCell id="p4c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c22" target="p4c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c26" value="&lt;b&gt;Database reachable&lt;br&gt;and MCP connected?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1450" width="260" height="120" as="geometry" /></mxCell><mxCell id="p4c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c24" target="p4c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c28" value="&lt;b&gt;4 · Introspect, read-only&lt;/b&gt;&lt;br&gt;list and describe tables&lt;br&gt;confirm surprises against real rows" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="1470" width="320" height="80" as="geometry" /></mxCell><mxCell id="p4c29" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c26" target="p4c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c30" value="&lt;b&gt;5 · Write context/BASELINE.md&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1610" width="400" height="50" as="geometry" /></mxCell><mxCell id="p4c31" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c26" target="p4c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c28" target="p4c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1640" /></Array></mxGeometry></mxCell><mxCell id="p4c33" value="&lt;b&gt;4 · STOP: approve the baseline&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1710" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c30" target="p4c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c35" value="&lt;b&gt;6 · Draft profile §2 to 4 and module tags&lt;/b&gt;&lt;br&gt;drafts for a person to correct" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1810" width="400" height="60" as="geometry" /></mxCell><mxCell id="p4c36" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c33" target="p4c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c37" value="&lt;b&gt;5 · STOP: show each draft first&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1910" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c38" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c35" target="p4c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c39" value="&lt;b&gt;7 · Draft navigation plans and the matrix&lt;/b&gt;&lt;br&gt;one plan per role&lt;br&gt;each matrix cell Verified or Not tested here" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2020" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c40" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c37" target="p4c39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c41" value="&lt;b&gt;6 · STOP: show the drafts&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="2130" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c42" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c39" target="p4c41"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c43" value="&lt;b&gt;8 · Deep context for named areas&lt;/b&gt;&lt;br&gt;context/&amp;lt;area&amp;gt;.md: rules, states,&lt;br&gt;recipes, verification queries" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2240" width="400" height="80" as="geometry" /></mxCell><mxCell id="p4c44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c41" target="p4c43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c45" value="&lt;b&gt;7 · STOP: show each document&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="2350" width="440" height="60" as="geometry" /></mxCell><mxCell id="p4c46" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c43" target="p4c45"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c47" value="&lt;b&gt;Self-audit (blocking)&lt;/b&gt;&lt;br&gt;nothing invented · provenance recorded&lt;br&gt;no writes to the app or database · no credentials&lt;br&gt;known unknowns populated" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2460" width="400" height="90" as="geometry" /></mxCell><mxCell id="p4c48" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c45" target="p4c47"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c49" value="Baseline written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="2590" width="320" height="40" as="geometry" /></mxCell><mxCell id="p4c50" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c47" target="p4c49"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p4c51" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;context/BASELINE.md · context/&amp;lt;area&amp;gt;.md&lt;br&gt;PROJECT-PROFILE.md §2 to 4&lt;br&gt;specs/UserFlowsUserRolePermissions/&lt;br&gt;specs/RegressionTags/regression-tags.md&lt;br&gt;with your yes: config/projectProfile.ts,&lt;br&gt;tests/seeds/, pages/LoginPage.ts,&lt;br&gt;pages/DashboardPage.ts" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="150" as="geometry" /></mxCell><mxCell id="p4c52" value="&lt;b&gt;The governing rule&lt;/b&gt;&lt;br&gt;record what you established, and name&lt;br&gt;what you did not: known unknowns&lt;br&gt;are a deliverable, not a failure" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="340" height="90" as="geometry" /></mxCell><mxCell id="p4c53" value="&lt;b&gt;When it runs&lt;/b&gt;&lt;br&gt;once at setup; again, scoped to one area&lt;br&gt;or role, when a module, role or&lt;br&gt;navigation changes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="410" width="340" height="90" as="geometry" /></mxCell><mxCell id="p4c54" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;reads .env or types a credential&lt;br&gt;submits a form or changes data&lt;br&gt;writes to the database&lt;br&gt;fills a matrix cell by symmetry" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="520" width="340" height="100" as="geometry" /></mxCell><mxCell id="p4c55" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2670" width="1560" height="30" as="geometry" /></mxCell><mxCell id="p4c901" value="&lt;b&gt;Context sync&lt;/b&gt;: after a run, from the executor&lt;br&gt;npm run context:sync, then only what you agree to:&lt;br&gt;verified marks · a caveat naming an open defect ·&lt;br&gt;an unknown answered · never a new rule&lt;br&gt;verified marks held while the rule has an open defect&lt;br&gt;an answered unknown leaves BASELINE.md&lt;br&gt;commits context: &amp;lt;areas&amp;gt;, verified by &amp;lt;KEYS&amp;gt;&lt;br&gt;[context-updated], then hands back" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="340" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page5" name="5 Test planning"><mxGraphModel dx="1640" dy="2358" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2358" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p5c1" value="&lt;b&gt;5 Test planning&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p5c2" value="Top to bottom: &lt;b&gt;/playwright-test-planner &amp;lt;KEY&amp;gt;&lt;/b&gt; turns one story into a plan. No browser: it grounds everything in the repo. It stops at &lt;b&gt;seven checkpoints&lt;/b&gt;; the independent plan review (purple) runs only if you say yes." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p5c3" value="/playwright-test-planner &amp;lt;KEY&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p5c4" value="&lt;b&gt;Story key&lt;br&gt;present and valid?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p5c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c3" target="p5c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c6" value="&lt;b&gt;STOP: ask for the key&lt;/b&gt;&lt;br&gt;no key-less mode (I8)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="340" height="80" as="geometry" /></mxCell><mxCell id="p5c7" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c4" target="p5c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c8" value="&lt;b&gt;Read the story&lt;/b&gt;&lt;br&gt;fetched from Jira by its key, or pasted&lt;br&gt;release = fix version · epic = parent epic, or asked&lt;br&gt;optional: existing test cases · the Figma frames it links" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="370" width="400" height="90" as="geometry" /></mxCell><mxCell id="p5c9" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c4" target="p5c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c10" value="&lt;b&gt;1 · STOP: confirm story, AC, gaps&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c8" target="p5c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c12" value="&lt;b&gt;Read PROJECT-PROFILE.md and the invariants&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="400" height="50" as="geometry" /></mxCell><mxCell id="p5c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c10" target="p5c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c14" value="&lt;b&gt;2 · STOP: approve the conventions&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c12" target="p5c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c16" value="&lt;b&gt;Inspect the repo, no live browser&lt;/b&gt;&lt;br&gt;context/ · navigation plans · pages/&lt;br&gt;lib/BaseTest.ts · data/ · existing specs" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="810" width="400" height="80" as="geometry" /></mxCell><mxCell id="p5c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c14" target="p5c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c18" value="&lt;b&gt;3 · STOP: approve reuse or cut scope&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="920" width="460" height="60" as="geometry" /></mxCell><mxCell id="p5c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c16" target="p5c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c20" value="&lt;b&gt;Analyse flows, design scenarios&lt;/b&gt;&lt;br&gt;EP · BVA · decision table · state transition&lt;br&gt;pairwise · error guessing&lt;br&gt;then the completeness critique" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1030" width="400" height="90" as="geometry" /></mxCell><mxCell id="p5c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c18" target="p5c20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c22" value="&lt;b&gt;4 · STOP: approve scenario titles&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1160" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c20" target="p5c22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c24" value="&lt;b&gt;New page object&lt;br&gt;or fixture needed?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1260" width="260" height="120" as="geometry" /></mxCell><mxCell id="p5c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c22" target="p5c24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c26" value="&lt;b&gt;5 · STOP: approve&lt;/b&gt;&lt;br&gt;what is new and where" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="1280" width="320" height="80" as="geometry" /></mxCell><mxCell id="p5c27" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c24" target="p5c26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c28" value="&lt;b&gt;Structure each scenario&lt;/b&gt;&lt;br&gt;TCID heading · Given/When/Then · Expected Result&lt;br&gt;Data · Priority by fixed questions" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1420" width="400" height="80" as="geometry" /></mxCell><mxCell id="p5c29" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c24" target="p5c28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c26" target="p5c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1460" /></Array></mxGeometry></mxCell><mxCell id="p5c31" value="&lt;b&gt;6 · STOP: approve the full plan&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1540" width="440" height="60" as="geometry" /></mxCell><mxCell id="p5c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c28" target="p5c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c33" value="&lt;b&gt;Run the&lt;br&gt;independent review?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1640" width="260" height="120" as="geometry" /></mxCell><mxCell id="p5c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c31" target="p5c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c35" value="&lt;b&gt;playwright-test-reviewer&lt;/b&gt;&lt;br&gt;plan review, fresh context&lt;br&gt;must fix folded in&lt;br&gt;each consider applied only once you decide,&lt;br&gt;then the self-audit re-run and every&lt;br&gt;changed scenario shown in full" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="1640" width="320" height="120" as="geometry" /></mxCell><mxCell id="p5c36" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c33" target="p5c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c37" value="&lt;b&gt;Self-audit before saving (blocking)&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1800" width="400" height="50" as="geometry" /></mxCell><mxCell id="p5c38" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c33" target="p5c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c35" target="p5c37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1820" /></Array></mxGeometry></mxCell><mxCell id="p5c40" value="&lt;b&gt;Save the plan&lt;/b&gt;&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1890" width="400" height="60" as="geometry" /></mxCell><mxCell id="p5c41" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c37" target="p5c40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c42" value="&lt;b&gt;7 · STOP: approve the CSV rows&lt;/b&gt;&lt;br&gt;every row compared with the markdown,&lt;br&gt;field by field" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1990" width="440" height="80" as="geometry" /></mxCell><mxCell id="p5c43" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c40" target="p5c42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c44" value="&lt;b&gt;Write the CSV and manual rows&lt;/b&gt;&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.csv · Not Run rows in&lt;br&gt;specs/execution/manual-results.csv" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="2100" width="400" height="80" as="geometry" /></mxCell><mxCell id="p5c45" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c42" target="p5c44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c46" value="Plan saved" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="2210" width="320" height="40" as="geometry" /></mxCell><mxCell id="p5c47" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c44" target="p5c46"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p5c48" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.md&lt;br&gt;specs/&amp;lt;KEY&amp;gt;.plan.csv&lt;br&gt;specs/execution/manual-results.csv" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="90" as="geometry" /></mxCell><mxCell id="p5c49" value="&lt;b&gt;TCIDs are assigned here only&lt;/b&gt;&lt;br&gt;&amp;lt;KEY&amp;gt;-TC&amp;lt;NNN&amp;gt;, never renumbered;&lt;br&gt;a dropped scenario is marked Retired" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="240" width="340" height="80" as="geometry" /></mxCell><mxCell id="p5c50" value="&lt;b&gt;Priority by fixed questions&lt;/b&gt;&lt;br&gt;data loss or no workaround → P1&lt;br&gt;only coverage of an AC → P1&lt;br&gt;secondary role or workaround → P2&lt;br&gt;otherwise → P3" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="340" height="100" as="geometry" /></mxCell><mxCell id="p5c51" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;plans without a story key&lt;br&gt;edits, comments on or moves the story&lt;br&gt;guesses a selector or a data key" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="460" width="340" height="90" as="geometry" /></mxCell><mxCell id="p5c52" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · purple = sub-agent · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="2300" width="1560" height="30" as="geometry" /></mxCell><mxCell id="p5c901" value="&lt;b&gt;Designs are intent, not rules&lt;/b&gt;&lt;br&gt;read sparingly through figma, cited in the plan's Design line&lt;br&gt;design-only details marked (design: &amp;lt;node&amp;gt;) · a design that disagrees with an AC is raised at checkpoint 1" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="570" width="340" height="120" as="geometry" /></mxCell><mxCell id="p5c902" value="&lt;b&gt;Git first&lt;/b&gt;&lt;br&gt;npm run story -- start &amp;lt;KEY&amp;gt;: clean tree · fetch · resume or the base you pick · fast-forward pull&lt;br&gt;commits test-plan(&amp;lt;KEY&amp;gt;) … [planned] · [plan-reviewed]" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="710" width="340" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page6" name="6 Test generation"><mxGraphModel dx="1640" dy="2040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2040" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p6c1" value="&lt;b&gt;6 Test generation&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p6c2" value="Top to bottom: &lt;b&gt;/playwright-test-generator&lt;/b&gt; drives the real browser through every plan step before it writes code, then has the spec &lt;b&gt;reviewed by default&lt;/b&gt; (purple). Missing inputs exit left; questions branch right." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry" /></mxCell><mxCell id="p6c3" value="/playwright-test-generator specs/&amp;lt;KEY&amp;gt;.plan.md" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="400" height="40" as="geometry" /></mxCell><mxCell id="p6c4" value="&lt;b&gt;Plan named and&lt;br&gt;scenario has a TCID?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p6c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c3" target="p6c4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c6" value="&lt;b&gt;STOP: ask&lt;/b&gt;&lt;br&gt;which plan; or add the&lt;br&gt;scenario to the plan;&lt;br&gt;never mints a TCID" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="340" height="100" as="geometry" /></mxCell><mxCell id="p6c7" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c4" target="p6c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c8" value="&lt;b&gt;Read the profile, invariants, context/&amp;lt;area&amp;gt;.md&lt;/b&gt;&lt;br&gt;and the navigation plans for each role&lt;br&gt;first checkpoint: every plan line it cannot&lt;br&gt;implement as written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="400" height="80" as="geometry" /></mxCell><mxCell id="p6c9" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c4" target="p6c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c10" value="&lt;b&gt;generator_setup_page with the seed&lt;/b&gt;&lt;br&gt;tests/seeds/&amp;lt;role&amp;gt;.spec.ts, or tests/seed.spec.ts&lt;br&gt;for a signed-out scenario; never logs in by hand&lt;br&gt;a role switch is a new setup with that role&#x27;s seed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingR