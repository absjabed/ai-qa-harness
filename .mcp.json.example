{
  "//": "Copy to .mcp.json and fill in. .mcp.json is gitignored — the database entry carries a password.",
  "//  This is Claude Code's format. Other tools use the same servers in their own config file —": "",
  "//  see agents/README.md for where each one looks.": "",

  "//  playwright-test": "REQUIRED by the context-builder, generator and healer. Ships with @playwright/test — no separate install. Verified against `npx playwright init-agents`, which generates this exact entry.",

  "//  database": "OPTIONAL but high value. Lets agents read the real schema instead of asking you for every query. The entry below is PostgreSQL; for SQL Server replace the engine flags with: --sqlserver --server CHANGE_ME --port 1433 --database CHANGE_ME --user CHANGE_ME_READONLY --password CHANGE_ME. This server has NO read-only mode, so use a READ-ONLY account against a QA database, never production — .claude/settings.json also denies its write tools. Version pinned: npx would otherwise fetch whatever is newest on every start. See docs/MCP.md.",

  "//  tracker": "OPTIONAL. Jira through Atlassian's remote MCP server: the planner fetches a story by its key, the defect-raiser creates bugs, the healer reads their status for retests. Run /mcp in Claude Code to sign in (OAuth). Keep ?tools=all — without it the server exposes one generic 'execute' tool, which would slip past the per-tool rules in .claude/settings.json, so that tool is denied. Keep the key 'tracker': the rules name tools as mcp__tracker__<tool>. Delete this entry if you will paste stories and import the defect CSV by hand.",

  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"]
    },

    "database": {
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/database-server@1.1.0",
        "--postgresql",
        "--host", "CHANGE_ME",
        "--port", "5432",
        "--database", "CHANGE_ME",
        "--user", "CHANGE_ME_READONLY",
        "--password", "CHANGE_ME",
        "--ssl", "true"
      ]
    },

    "tracker": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp?tools=all"
    }
  }
}
