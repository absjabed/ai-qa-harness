ht="100" as="geometry" /></mxCell><mxCell id="p6c17" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c14" target="p6c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c18" value="&lt;b&gt;DB check needs a&lt;br&gt;query not in&lt;br&gt;sql_queries.ts?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="870" width="260" height="140" as="geometry" /></mxCell><mxCell id="p6c19" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c14" target="p6c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c20" value="then implements it" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c16" target="p6c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="630" /></Array></mxGeometry></mxCell><mxCell id="p6c21" value="&lt;b&gt;STOP: ask for the SQL&lt;/b&gt;&lt;br&gt;never writes it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="320" height="80" as="geometry" /></mxCell><mxCell id="p6c22" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c18" target="p6c21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c23" value="&lt;b&gt;generator_read_log:&lt;br&gt;an action per step?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1050" width="260" height="120" as="geometry" /></mxCell><mxCell id="p6c24" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c18" target="p6c23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c21" target="p6c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1110" /></Array></mxGeometry></mxCell><mxCell id="p6c26" value="no: drive again" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c23" target="p6c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="1110" /><mxPoint x="410" y="510" /></Array></mxGeometry></mxCell><mxCell id="p6c27" value="&lt;b&gt;STOP: confirm the target file path&lt;/b&gt;&lt;br&gt;tests/stories/&amp;lt;release&amp;gt;/ · &amp;lt;EPIC-KEY&amp;gt;/ · root" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1210" width="520" height="80" as="geometry" /></mxCell><mxCell id="p6c28" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c23" target="p6c27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c29" value="&lt;b&gt;Self-audit before writing (blocking)&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1330" width="400" height="50" as="geometry" /></mxCell><mxCell id="p6c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c27" target="p6c29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c31" value="&lt;b&gt;generator_write_test&lt;/b&gt;&lt;br&gt;title = TCID + summary · one test.step per plan line&lt;br&gt;priority tags + module tag" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1420" width="400" height="80" as="geometry" /></mxCell><mxCell id="p6c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c29" target="p6c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c33" value="&lt;b&gt;playwright-test-reviewer: test review&lt;/b&gt;&lt;br&gt;fresh context, by default; skipped only on no review" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1540" width="400" height="60" as="geometry" /></mxCell><mxCell id="p6c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c31" target="p6c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c35" value="&lt;b&gt;must fix&lt;br&gt;findings?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="1640" width="260" height="120" as="geometry" /></mxCell><mxCell id="p6c36" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c33" target="p6c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c37" value="&lt;b&gt;Fix them&lt;/b&gt;&lt;br&gt;re-drive the step live if needed&lt;br&gt;re-review once; show what still fails" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="1660" width="320" height="80" as="geometry" /></mxCell><mxCell id="p6c38" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c35" target="p6c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c39" value="Spec written and reviewed" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1900" width="320" height="40" as="geometry" /></mxCell><mxCell id="p6c40" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c35" target="p6c48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p6c41" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6c37" target="p6c48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1830" /></Array></mxGeometry></mxCell><mxCell id="p6c42" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;tests/stories/&amp;lt;release&amp;gt;/&amp;lt;KEY&amp;gt;.spec.ts&lt;br&gt;pages/&amp;lt;Name&amp;gt;Page.ts · lib/BaseTest.ts&lt;br&gt;data/sql_queries.ts: SQL you supply&lt;br&gt;regression-tags.md: a tag you approve" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="340" height="100" as="geometry" /></mxCell><mxCell id="p6c43" value="&lt;b&gt;Tags from the plan's priority&lt;/b&gt;&lt;br&gt;P1 → @Regression @Priority1&lt;br&gt;P2 → @Regression @Priority2&lt;br&gt;P3 → @Priority3 · plus a module tag" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="250" width="340" height="90" as="geometry" /></mxCell><mxCell id="p6c44" value="&lt;b&gt;File path&lt;/b&gt;&lt;br&gt;a release → tests/stories/&amp;lt;release&amp;gt;/&lt;br&gt;no release, an epic → &amp;lt;EPIC-KEY&amp;gt;/&lt;br&gt;neither → tests/stories/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="360" width="340" height="90" as="geometry" /></mxCell><mxCell id="p6c45" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;writes a step it did not drive live&lt;br&gt;reads .env or logs in by hand&lt;br&gt;invents a module tag or SQL" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="470" width="340" height="90" as="geometry" /></mxCell><mxCell id="p6c46" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · purple = sub-agent · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="1560" height="30" as="geometry" /></mxCell><mxCell id="p6c47" value="&lt;b&gt;Git&lt;/b&gt;&lt;br&gt;works on the story&#x27;s branch&lt;br&gt;commits test-gen(&amp;lt;KEY&amp;gt;): … [tests-generated]&lt;br&gt;then test-review(&amp;lt;KEY&amp;gt;): … [tests-reviewed]&lt;br&gt;one line, git commit -m only" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="580" width="340" height="100" as="geometry" /></mxCell><mxCell id="p6c48" value="&lt;b&gt;Asks: run these tests now?&lt;/b&gt;&lt;br&gt;a yes hands over to /playwright-test-executor (page 7)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1800" width="400" height="60" as="geometry" /></mxCell><mxCell id="p6c49" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c48" target="p6c39"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page7" name="7 Running tests"><mxGraphModel dx="1680" dy="1860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1860" background="#ffffff" math="0" shadow="0"><root><mxCell id="p7c0" /><mxCell id="p7c1" parent="p7c0" /><mxCell id="p7c2" value="&lt;b&gt;7 Running tests&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="p7c1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p7c3" value="Top to bottom: &lt;b&gt;/playwright-test-executor&lt;/b&gt; runs one story's tests or a release's regression and sees the run through: failures to the healer, defects to the defect-raiser, the report to the reporter. It never starts without &lt;b&gt;your yes&lt;/b&gt;, and every figure it gives comes from the scripts. What a run records is on page 10." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="p7c1"><mxGeometry x="40" y="60" width="1600" height="40" as="geometry" /></mxCell><mxCell id="p7c4" value="/playwright-test-executor" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p7c5" value="&lt;b&gt;1 · What to run&lt;/b&gt;&lt;br&gt;story run: every test of the chosen stories, on the story's branch (not on it: npm run story -- start &amp;lt;KEY&amp;gt; --resume)&lt;br&gt;regression run: a release, epics or tickets, @Regression by default, on release/&amp;lt;x&amp;gt; freshly pulled (npm run story -- switch)" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="420" y="210" width="440" height="110" as="geometry" /></mxCell><mxCell id="p7c6" value="&lt;b&gt;2 · Dry run&lt;/b&gt;&lt;br&gt;npm run regression -- … --dry-run&lt;br&gt;tickets · test runs · browsers · build: nothing recorded&lt;br&gt;well over a hundred test runs: offers to split it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="420" y="370" width="440" height="90" as="geometry" /></mxCell><mxCell id="p7c7" value="&lt;b&gt;STOP: run it?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;a narrow re-run you asked for: dry run shown, no second yes&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="420" y="500" width="440" height="70" as="geometry" /></mxCell><mxCell id="p7c8" value="Nothing run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="110" y="505" width="200" height="60" as="geometry" /></mxCell><mxCell id="p7c9" value="&lt;b&gt;3 · Run&lt;/b&gt;&lt;br&gt;npm run regression -- … --headless --yes&lt;br&gt;always in the foreground; a long selection story by story&lt;br&gt;commit test-run(&amp;lt;KEY&amp;gt;): &amp;lt;n&amp;gt; passed, &amp;lt;n&amp;gt; failed [run]&lt;br&gt;narrow re-run: test-run(&amp;lt;KEY&amp;gt;): re-run &amp;lt;TCIDs&amp;gt;, … [run]" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="420" y="610" width="440" height="110" as="geometry" /></mxCell><mxCell id="p7c10" value="&lt;b&gt;4 · npm run results:last&lt;/b&gt;&lt;br&gt;totals · failures grouped by spec and error&lt;br&gt;manual cases still Not Run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="420" y="760" width="440" height="70" as="geometry" /></mxCell><mxCell id="p7c11" value="&lt;b&gt;Failures?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="510" y="870" width="260" height="110" as="geometry" /></mxCell><mxCell id="p7c12" value="&lt;b&gt;STOP: heal all · these groups&lt;br&gt;skip · stop&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="900" y="885" width="340" height="80" as="geometry" /></mxCell><mxCell id="p7c13" value="&lt;b&gt;/playwright-test-healer&lt;/b&gt; with that scope&lt;br&gt;then the executor takes the session back: results:last and the defect log read again" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="900" y="1010" width="340" height="80" as="geometry" /></mxCell><mxCell id="p7c14" value="&lt;b&gt;5 · Pending defects?&lt;/b&gt;&lt;br&gt;offer /playwright-defect-raiser" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="420" y="1140" width="440" height="60" as="geometry" /></mxCell><mxCell id="p7c15" value="&lt;b&gt;6 · Manual cases Not Run?&lt;/b&gt;&lt;br&gt;enter results now, or leave them" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="420" y="1240" width="440" height="60" as="geometry" /></mxCell><mxCell id="p7c16" value="&lt;b&gt;7 · The report&lt;/b&gt;&lt;br&gt;offer /playwright-test-reporter, this run's scope&lt;br&gt;hand-over is only: scope; formats; by" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="420" y="1340" width="440" height="70" as="geometry" /></mxCell><mxCell id="p7c17" value="&lt;b&gt;8 · npm run context:sync -- --text&lt;/b&gt;&lt;br&gt;its output pasted verbatim: rules verified or contradicted · unknowns a case may answer&lt;br&gt;a contradicted rule's passing cases are held&lt;br&gt;apply? → /playwright-context-builder" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="420" y="1450" width="440" height="100" as="geometry" /></mxCell><mxCell id="p7c18" value="&lt;b&gt;9 · npm run story -- status&lt;/b&gt;&lt;br&gt;may merge → finish · push · pull request, each asked&lt;br&gt;waiting → commit [on-hold], push asked" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="420" y="1600" width="440" height="70" as="geometry" /></mxCell><mxCell id="p7c19" value="Run finished" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p7c1"><mxGeometry x="480" y="1710" width="320" height="40" as="geometry" /></mxCell><mxCell id="p7c20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c4" target="p7c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c5" target="p7c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c6" target="p7c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c23" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p7c1" source="p7c7" target="p7c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c24" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c7" target="p7c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c9" target="p7c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c10" target="p7c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c27" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p7c1" source="p7c11" target="p7c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c28" value="heal" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p7c1" source="p7c12" target="p7c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p7c1" source="p7c13" target="p7c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="1170" /></Array></mxGeometry></mxCell><mxCell id="p7c30" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c11" target="p7c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c14" target="p7c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c15" target="p7c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c33" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c16" target="p7c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c17" target="p7c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c35" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p7c1" source="p7c18" target="p7c19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p7c36" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;test-results/results.json · the results CSVs&lt;br&gt;specs/defects/log/ · the plans&lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;manual results you give · its results commit&lt;br&gt;how a run is recorded: page 10" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="1300" y="130" width="340" height="120" as="geometry" /></mxCell><mxCell id="p7c37" value="&lt;b&gt;Every figure from the scripts&lt;/b&gt;&lt;br&gt;--dry-run · results:last · story -- status · the defect log · manual results&lt;br&gt;npm run report:cycle -- &amp;lt;scope&amp;gt; --preview: read only, what fails across a scope" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="1300" y="280" width="340" height="100" as="geometry" /></mxCell><mxCell id="p7c38" value="&lt;b&gt;After every hand-over&lt;/b&gt;&lt;br&gt;the executor takes the session back and reads the state again; also after anything you run by hand, before any commit or claim" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="1300" y="410" width="340" height="90" as="geometry" /></mxCell><mxCell id="p7c39" value="&lt;b&gt;Resuming&lt;/b&gt;&lt;br&gt;a session that ended mid-run starts from results:last and carries on at step 4" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="1300" y="520" width="340" height="70" as="geometry" /></mxCell><mxCell id="p7c40" value="&lt;b&gt;The generator hands over&lt;/b&gt;&lt;br&gt;after a clean test review it asks: run these tests now?" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="1300" y="610" width="340" height="60" as="geometry" /></mxCell><mxCell id="p7c41" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;runs without your yes&lt;br&gt;fixes a test, a page object or a locator&lt;br&gt;marks a test fixme, files a bug or posts to Jira&lt;br&gt;counts a figure itself · reads .env" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p7c1"><mxGeometry x="1300" y="700" width="340" height="110" as="geometry" /></mxCell><mxCell id="p7c42" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · red box = never · green = rule · orange = files read or written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="p7c1"><mxGeometry x="40" y="1790" width="1600" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page8" name="8 Healing failures"><mxGraphModel dx="1680" dy="1420" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1420" background="#ffffff" math="0" shadow="0"><root><mxCell id="p8c0" /><mxCell id="p8c1" parent="p8c0" /><mxCell id="p8c2" value="&lt;b&gt;8 Healing failures&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="p8c1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p8c3" value="Top to bottom: &lt;b&gt;/playwright-test-healer&lt;/b&gt; fixes test-side failures itself and stops for you only on a genuine application bug, or when a fix would change &lt;b&gt;what a test expects&lt;/b&gt;. The fix loop is on the right." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="p8c1"><mxGeometry x="40" y="60" width="1600" height="40" as="geometry" /></mxCell><mxCell id="p8c4" value="/playwright-test-healer &amp;lt;KEY · spec · TCID&amp;gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="440" y="130" width="400" height="40" as="geometry" /></mxCell><mxCell id="p8c5" value="&lt;b&gt;Told what&lt;br&gt;to heal?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="510" y="210" width="260" height="120" as="geometry" /></mxCell><mxCell id="p8c6" value="&lt;b&gt;STOP: confirm what to heal&lt;/b&gt;&lt;br&gt;lists the last run's failures&lt;br&gt;from test-results/results.json" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="40" y="220" width="340" height="100" as="geometry" /></mxCell><mxCell id="p8c7" value="&lt;b&gt;test_run on the tests in scope&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="420" y="370" width="440" height="50" as="geometry" /></mxCell><mxCell id="p8c8" value="&lt;b&gt;test_debug each failure&lt;/b&gt;&lt;br&gt;snapshot · console · network · read-only DB query&lt;br&gt;a paused debug run ends with browser_resume&lt;br&gt;an Expected Result the plan marks as an assumption: a question for you, not debugged" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="420" y="460" width="440" height="100" as="geometry" /></mxCell><mxCell id="p8c9" value="&lt;b&gt;Genuine application&lt;br&gt;bug?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reproduced twice, test-side&lt;br&gt;causes ruled out&lt;/font&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="500" y="600" width="280" height="140" as="geometry" /></mxCell><mxCell id="p8c10" value="&lt;b&gt;Fix on the test side&lt;/b&gt;&lt;br&gt;selector · wait · locator scope&lt;br&gt;in the page object or testData.ts" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="900" y="630" width="340" height="80" as="geometry" /></mxCell><mxCell id="p8c11" value="&lt;b&gt;STOP: expected-value guard&lt;/b&gt;&lt;br&gt;changes what the test expects? read its plan row&lt;br&gt;plan says it → defect candidate&lt;br&gt;test misread the plan → fix on your yes&lt;br&gt;plan out of date → the planner revises it" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="890" y="750" width="360" height="120" as="geometry" /></mxCell><mxCell id="p8c12" value="&lt;b&gt;STOP: after 3 attempts&lt;/b&gt;&lt;br&gt;summarise and ask" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="900" y="910" width="340" height="70" as="geometry" /></mxCell><mxCell id="p8c13" value="&lt;b&gt;STOP: confirm the defect&lt;/b&gt;&lt;br&gt;and its severity, P1 to P4" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="420" y="770" width="440" height="80" as="geometry" /></mxCell><mxCell id="p8c14" value="&lt;b&gt;Log it&lt;/b&gt;&lt;br&gt;specs/defects/log/&amp;lt;entry id&amp;gt;.json · status pending&lt;br&gt;times from npm run env -- now" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="420" y="890" width="440" height="70" as="geometry" /></mxCell><mxCell id="p8c15" value="&lt;b&gt;npm run defect:evidence&lt;/b&gt;&lt;br&gt;keeps screenshots in specs/defects/evidence/&amp;lt;entry id&amp;gt;/&lt;br&gt;finds nothing → npx playwright test &amp;lt;specFile&amp;gt; -g &amp;lt;TCID&amp;gt;, then again; refused → asks you" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="420" y="1000" width="440" height="90" as="geometry" /></mxCell><mxCell id="p8c16" value="&lt;b&gt;Changed a test? Run the healed specs once more&lt;/b&gt;&lt;br&gt;npx playwright test &amp;lt;spec files&amp;gt;, so the results reach the record&lt;br&gt;healed nothing → no re-run" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="420" y="1130" width="440" height="80" as="geometry" /></mxCell><mxCell id="p8c17" value="Fixed tests, or defects pending" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p8c1"><mxGeometry x="480" y="1250" width="320" height="40" as="geometry" /></mxCell><mxCell id="p8c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c4" target="p8c5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c19" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8c1" source="p8c5" target="p8c6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c20" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c5" target="p8c7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c7" target="p8c8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c8" target="p8c9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c23" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8c1" source="p8c9" target="p8c10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c10" target="p8c11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c25" value="still failing" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c11" target="p8c12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c26" value="rerun" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8c1" source="p8c11" target="p8c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="810" /><mxPoint x="1290" y="395" /></Array></mxGeometry></mxCell><mxCell id="p8c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8c1" source="p8c11" target="p8c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c28" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c9" target="p8c13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c13" target="p8c14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c14" target="p8c15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c15" target="p8c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="p8c1" source="p8c16" target="p8c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p8c33" value="&lt;b&gt;Files it writes&lt;/b&gt;&lt;br&gt;pages/ · data/testData.ts: fixes&lt;br&gt;specs/defects/log/&amp;lt;entry id&amp;gt;.json&lt;br&gt;specs/defects/evidence/&amp;lt;entry id&amp;gt;/" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="1320" y="130" width="320" height="90" as="geometry" /></mxCell><mxCell id="p8c34" value="&lt;b&gt;Commits&lt;/b&gt;, saying first what&lt;br&gt;a fixed test: test-heal(&amp;lt;KEY&amp;gt;): &amp;lt;TCID&amp;gt; … [healed]&lt;br&gt;a defect: its entry and evidence only, defect(&amp;lt;KEY&amp;gt;): &amp;lt;TCID&amp;gt; confirmed … [defect-recorded]&lt;br&gt;on the story's branch, or the release branch the regression ran on" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="1320" y="240" width="320" height="120" as="geometry" /></mxCell><mxCell id="p8c35" value="&lt;b&gt;Defects found by hand&lt;/b&gt;&lt;br&gt;a tester gives the TCID and what happened; same confirmation, logged as foundBy manual" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="1320" y="390" width="320" height="80" as="geometry" /></mxCell><mxCell id="p8c36" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;changes a TCID&lt;br&gt;skips, fixmes or deletes a test to pass&lt;br&gt;guesses database state without access&lt;br&gt;reroutes a refused call: you get the exact command" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p8c1"><mxGeometry x="1320" y="490" width="320" height="110" as="geometry" /></mxCell><mxCell id="p8c37" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP, waits for you · red box = hard rule · green = rule · orange = files written" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="p8c1"><mxGeometry x="40" y="1340" width="1600" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram id="page9" name="9 Defects and retest"><mxGraphModel dx="1680" dy="2380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="2380" background="#ffffff" math="0" shadow="0"><root><mxCell id="p9c0" /><mxCell id="p9c1" parent="p9c0" /><mxCell id="p9c2" value="&lt;b&gt;9 Defects and retest&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;" vertex="1" parent="p9c1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry" /></mxCell><mxCell id="p9c3" value="Two flows. Top: &lt;b&gt;/playwright-defect-raiser&lt;/b&gt; files the defects the healer logged, after &lt;b&gt;one confirmation&lt;/b&gt;, in Jira mode or CSV mode. Bottom: the healer's &lt;b&gt;retest&lt;/b&gt; once a bug is fixed. Nothing is written to Jira without your yes." style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="p9c1"><mxGeometry x="40" y="60" width="1600" height="40" as="geometry" /></mxCell><mxCell id="p9c4" value="/playwright-defect-raiser" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="480" y="130" width="320" height="40" as="geometry" /></mxCell><mxCell id="p9c5" value="&lt;b&gt;Read the pending entries&lt;/b&gt;&lt;br&gt;specs/defects/log/: all, or the stories and TCIDs you name" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="420" y="210" width="440" height="70" as="geometry" /></mxCell><mxCell id="p9c6" value="&lt;b&gt;Jira tools&lt;br&gt;connected?&lt;/b&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="510" y="320" width="260" height="120" as="geometry" /></mxCell><mxCell id="p9c7" value="&lt;b&gt;Jira mode&lt;/b&gt;&lt;br&gt;search for an open bug labelled with the TCID: reuse it, never file twice" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="900" y="340" width="340" height="80" as="geometry" /></mxCell><mxCell id="p9c8" value="&lt;b&gt;CSV mode&lt;/b&gt;&lt;br&gt;asks the Reporter name once" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="40" y="345" width="340" height="70" as="geometry" /></mxCell><mxCell id="p9c9" value="&lt;b&gt;STOP: confirm the batch&lt;/b&gt;&lt;br&gt;summary · severity · TCID · story · evidence" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="320" y="490" width="640" height="80" as="geometry" /></mxCell><mxCell id="p9c10" value="&lt;b&gt;CSV mode: append rows&lt;/b&gt;&lt;br&gt;specs/defects/defects.csv&lt;br&gt;evidence attached by hand after import" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="330" y="620" width="300" height="90" as="geometry" /></mxCell><mxCell id="p9c11" value="&lt;b&gt;Jira mode: create the bug&lt;/b&gt;&lt;br&gt;link to the story · attach evidence if the tools can upload · record trackerKey" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="650" y="620" width="300" height="90" as="geometry" /></mxCell><mxCell id="p9c12" value="&lt;b&gt;Mark it&lt;/b&gt;&lt;br&gt;automated test → test.fixme( with a comment&lt;br&gt;manual case → key in manual-results.csv Notes" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="420" y="760" width="440" height="80" as="geometry" /></mxCell><mxCell id="p9c13" value="&lt;b&gt;Entry status → raised&lt;/b&gt;&lt;br&gt;raisedAt from npm run env -- now" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="420" y="880" width="440" height="60" as="geometry" /></mxCell><mxCell id="p9c14" value="&lt;b&gt;Commit, one per story&lt;/b&gt;&lt;br&gt;defect(&amp;lt;KEY&amp;gt;): &amp;lt;n&amp;gt; raised … [defect-raised]&lt;br&gt;the entries · the specs marked fixme · defects.csv in CSV mode" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="p9c1"><mxGeometry x="420" y="980" width="440" height="80" as="geometry" /></mxCell><mxCell id="p9c15" value="Defects raised" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="p9c1"><mxGeometry x="480" y="1100" width="320" height="40" as="geometry" /></mxCell><mxCell id="p9c16" value="" style