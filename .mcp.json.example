{
  "//": "Copy to .mcp.json and fill in. .mcp.json is gitignored — it may contain a connection string.",
  "//  playwright-test": "Required by the generator and healer agents. Without it the generator cannot drive the browser and will not write tests.",
  "//  database": "Optional but high value. Lets agents introspect the real schema instead of asking you for every query. Use a READ-ONLY account against a QA database. Never production.",

  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--caps=testing"]
    },

    "database": {
      "command": "npx",
      "args": [
        "-y",
        "CHANGE_ME-your-sql-mcp-server",
        "--connection-string",
        "Server=CHANGE_ME;Database=CHANGE_ME;User Id=CHANGE_ME_READONLY;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=true"
      ]
    }
  }
}
