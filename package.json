{
  "name": "ai-qa-harness",
  "version": "0.0.0",
  "description": "AI-driven Playwright test harness. Configure per project via PROJECT-PROFILE.md. Harness version: CHANGELOG.md.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "docs": "node scripts/open-docs.js",
    "export": "node scripts/export-harness.js",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:regression": "playwright test --grep \"@Regression\"",
    "regression": "ts-node -r tsconfig-paths/register scripts/regression.ts",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "report:cycle": "ts-node -r tsconfig-paths/register scripts/cycle-report.ts",
    "defect:evidence": "ts-node -r tsconfig-paths/register scripts/defect-evidence.ts",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.js",
    "check:trace": "ts-node -r tsconfig-paths/register scripts/check-trace.ts",
    "check": "npm run typecheck && npm run check:docs && npm run check:trace",
    "db:check": "ts-node -r tsconfig-paths/register config/testDbConnection.ts",
    "setup": "playwright install"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "ai"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.57.0",
    "@types/mssql": "^9.1.9",
    "@types/node": "^25.0.9",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.2.3",
    "mssql": "^12.2.0",
    "pg": "^8.23.1",
    "playwright": "^1.57.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
